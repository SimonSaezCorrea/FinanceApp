# Production environment of the API, as /opt/fik/api.env on the EC2 server (chmod 600, root).
# Never commit the real file. Generate each secret with: openssl rand -base64 48
# (MFA_ENCRYPTION_KEY instead: openssl rand -hex 32)

# RDS (private network, same VPC), always over TLS.
# The app (node-postgres) verifies the server certificate against the RDS CA bundle that
# docker-compose.yml mounts and exposes through NODE_EXTRA_CA_CERTS.
DATABASE_URL="postgresql://fik_app:CHANGE_ME@CHANGE_ME.us-east-2.rds.amazonaws.com:5432/fik?sslmode=verify-full"
# Migrations (`prisma migrate deploy`, its own engine, Prisma's TLS parameters): sslcert is the CA
# to trust and sslaccept=strict makes it verify the certificate chain.
DIRECT_DATABASE_URL="postgresql://fik_app:CHANGE_ME@CHANGE_ME.us-east-2.rds.amazonaws.com:5432/fik?sslmode=require&sslcert=/certs/rds-ca.pem&sslaccept=strict"

CORS_ORIGIN="https://mifik.cl,https://app.mifik.cl"
PASSKEY_RP_ID="mifik.cl"
# Caddy is the only proxy the API trusts (it rewrites X-Forwarded-For from CF-Connecting-IP).
TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
CURSOR_SIGNING_SECRET=""
MFA_ENCRYPTION_KEY=""
MFA_PENDING_TOKEN_SECRET=""
PASSKEY_CHALLENGE_SECRET=""
IDENTIFIER_HASH_SECRET=""

# Optional: country of each session (Profile → Security). Without it, no country.
IPINFO_TOKEN=""

# Emails (specs/032): the Resend key with "Sending access" restricted to mifik.cl. Without it,
# production sends no email (the app keeps working and says so where it matters).
RESEND_API_KEY=""
# Where the links in the emails open.
PUBLIC_SITE_URL="https://mifik.cl"
