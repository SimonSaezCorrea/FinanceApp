{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**", "build/**"],
      "env": [
        "VITE_API_URL",
        "VITE_LANDING_URL",
        "PUBLIC_API_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_SITE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_ACCESS_EXPIRES",
        "JWT_REFRESH_EXPIRES",
        "CURSOR_SIGNING_SECRET",
        "MFA_ENCRYPTION_KEY",
        "MFA_PENDING_TOKEN_SECRET",
        "PASSKEY_CHALLENGE_SECRET",
        "IDENTIFIER_HASH_SECRET"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
