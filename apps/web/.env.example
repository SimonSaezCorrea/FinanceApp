# App environment — the backend base URL and where the public site lives (sign-in, sign-out).
VITE_API_URL="http://localhost:3001"
VITE_LANDING_URL="http://localhost:4321"

# Browser errors to Sentry — empty = nothing is sent (local development). Production sets it in the
# deploy workflow (repo variable SENTRY_DSN_WEB), e.g. https://<key>@o<org>.ingest.us.sentry.io/<project>
VITE_SENTRY_DSN=
