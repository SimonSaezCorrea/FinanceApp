// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(cuid())
  name                 String?
  email                String?         @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  preferredCurrency    String          @default("CLP")
  locale               String          @default("es")
  dateFormat           String          @default("DD/MM/YYYY")
  theme                String          @default("dark")
  status               UserStatus      @default(ACTIVE)
  createdAt            DateTime        @default(now())
  /// Optional link to the user's country of residence (reuses the reference `Country` table).
  countryId            String?
  addressStreet        String?
  addressCity          String?
  addressRegion        String?
  addressPostalCode    String?
  birthDate            DateTime?
  /// National identity document type (RUT is Chile-specific; DNI/PASSPORT/OTHER cover other countries).
  identifierType       IdentifierType?
  /// The identifier's value. Format is only validated when identifierType is RUT (Chilean check digit).
  identifierValue      String?
  phone                String?
  /// Masks monetary amounts across the app when true (real effect — see PENDING.md for coverage scope).
  hideBalances         Boolean         @default(false)
  monthlyBudgetTarget  Decimal?        @db.Decimal(18, 4)
  /// Day of month (1-28) the user's financial cycle starts. Stored, not yet wired into "this month" calculations (see PENDING.md).
  billingCycleStartDay Int?
  /// Extra currencies the user wants tracked, on top of preferredCurrency. Selection only — no live FX conversion.
  extraCurrencies      String[]        @default([])
  /// % of monthlyBudgetTarget at which to warn the user. Stored for the Notifications UI; no real alert is sent yet.
  budgetAlertThreshold Int?            @default(80)

  country           Country?                @relation(fields: [countryId], references: [id], onDelete: SetNull)
  bankAccounts      BankAccount[]
  transactions      Transaction[]
  installmentPlans  InstallmentPlan[]
  debts             Debt[]
  savingsGoals      SavingsGoal[]
  savingsEntries    SavingsEntry[]
  investments       Investment[]
  recurringExpenses RecurringExpense[]
  walletItems       WalletItemDashboard[]
  attachments       TransactionAttachment[]

  @@index([countryId])
  @@map("user")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// National identity document vocabulary. Which types a given country supports is data
/// (`CountryIdentifierType`), not fixed per-enum-value — a country may support more than one
/// (e.g. a national id + passport).
enum IdentifierType {
  RUT
  DNI
  PASSPORT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING // Corriente
  SIGHT // Vista / Cuenta RUT
  SAVINGS // Ahorro
  INVESTMENT // Inversiones (Fintual)
  CREDIT_LINE // Línea de crédito (tarjeta de crédito sin cuenta bancaria / retail)
  PREPAID // Cuenta prepago: fondos provisionados (emisor bancario o no bancario), sin crédito
  CASH // Efectivo
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

/// Processing network a card runs on. Redcompra is the Chilean domestic one (still
/// the only network on some older debit cards).
enum CardNetwork {
  VISA
  MASTERCARD
  AMEX
  REDCOMPRA
  OTHER
}

/// Physical payment instruments (the "plastic"). Prepaid included.
enum CardKind {
  CREDIT
  DEBIT
  PREPAID
}

model BankAccount {
  id                String        @id @default(cuid())
  userId            String
  name              String
  type              AccountType   @default(CHECKING)
  status            AccountStatus @default(ACTIVE)
  currency          String        @default("CLP")
  /// Free-text institution name (mirrors the selected bank's name; kept for display / manual entry).
  institution       String?
  /// Optional link to a registered FinancialInstitution (the "institution" selector). Null for cash/manual.
  institutionId     String?
  /// Bank account number (free text, stored/displayed in full — NOT a card PAN).
  accountNumber     String?
  /// User-set seed balance (own funds). For CREDIT_LINE accounts typically 0.
  initialBalance    Decimal       @default(0) @db.Decimal(18, 4)
  /// Reconciled/cached balance = initialBalance + Σincome − Σexpense.
  currentBalance    Decimal       @default(0) @db.Decimal(18, 4)
  /// Credit pool for CREDIT_LINE accounts (shared by all its cards). 0 otherwise.
  creditLimit       Decimal       @default(0) @db.Decimal(18, 4)
  /// Seed of already-used credit at account creation. Immutable baseline used only to
  /// initialize `creditUsed` — never recomputed into afterward.
  creditUsedInitial Decimal       @default(0) @db.Decimal(18, 4)
  /// Persisted, live "used" balance for the account's shared credit pool. Seeded from
  /// `creditUsedInitial` at creation; incremented/decremented by transactions (see
  /// TransactionsService) and decremented when a `CreditStatement` is paid.
  /// No longer derived/recomputed on read.
  creditUsed        Decimal       @default(0) @db.Decimal(18, 4)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialInstitution FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  transactions         Transaction[]
  investments          Investment[]
  cards                CardAccount[]
  recurringExpenses    RecurringExpense[]
  walletItems          WalletItemDashboard[]
  /// Statements belonging to THIS credit account's pool.
  creditStatements     CreditStatement[]     @relation("CreditStatementAccount")
  /// Statements (of some OTHER credit account) paid FROM this account.
  paidStatements       CreditStatement[]     @relation("CreditStatementPaidFrom")
  billingSettings      BillingSettings?

  @@index([userId])
  @@index([status])
  @@index([institutionId])
  @@map("bank-account")
}

enum BillingPaymentMethod {
  MANUAL
  AUTOMATIC
}

/// Billing configuration for an account's shared credit pool — split out from
/// `BankAccount` (1:1) so it can be reviewed/maintained/searched independently
/// instead of growing the account table with every billing-related field.
model BillingSettings {
  id                    String               @id @default(cuid())
  accountId             String               @unique
  /// Statement cut-off day (1-28). Drives automatic statement generation (cron +
  /// manual "Generar facturación" button, see `BillingGenerationService`) — when this
  /// day passes, the account's currently OPEN `CreditStatement` (if any) is closed.
  billingCycleDay       Int?
  /// Whether the user intends to pay the credit statement manually or automatically.
  /// Stored preference only — AUTOMATIC is currently LOCKED in the UI (not selectable):
  /// the payment-due-date design isn't finalized yet, so no automatic payment can be
  /// scheduled safely (see PENDING.md). Column kept for when that ships.
  paymentMethod         BillingPaymentMethod @default(MANUAL)
  /// Day of month (1-28) the statement is due. Nullable/unused while AUTOMATIC is
  /// locked — no UI writes this yet (see PENDING.md).
  paymentDueDay         Int?
  /// Percentage of a statement that counts as its MINIMUM payment (e.g. 5 = 5%).
  /// There is no universal rule for this — each issuer sets its own — so it is
  /// per-account configuration rather than a constant. Null = this account has no
  /// minimum defined, and the UI offers no "minimum" option for it.
  minimumPaymentPercent Decimal?             @db.Decimal(5, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("billing-settings")
}

/// A billing period for an account's shared credit pool ("facturación"). Transactions
/// that contribute to the pool are linked here live, as they happen
/// (`Transaction.creditStatementId`) — while unpaid, the amount is NOT stored here but
/// computed on read as the live sum of linked transactions (see
/// `AccountsService`/`BillingGenerationService`). Derived status (not persisted):
/// OPEN (`closedAt` null, still accumulating) → PENDING (`closedAt` set by
/// generation, awaiting payment) → PAID (`paidAt` set).
model CreditStatement {
  id                String    @id @default(cuid())
  accountId         String
  /// When this period started accumulating (the previous statement's `closedAt`, or
  /// the account's `createdAt` for the very first one).
  periodStart       DateTime
  /// Sealed by generation (cron/manual button) once `billingCycleDay` passes — null
  /// while still open/accumulating.
  closedAt          DateTime?
  /// Set when paid. Only then is `amount` meaningful (frozen at pay time) and only
  /// then can `amount` be corrected manually (no cascade to the linked payment
  /// transaction or to `creditUsed` — a deliberate, personal-use simplification).
  paidAt            DateTime?
  /// Frozen snapshot amount, set at pay time. Null/ignored while unpaid — the
  /// live amount is computed by summing linked transactions instead.
  amount            Decimal?  @db.Decimal(18, 4)
  /// How much was actually paid for this period. A payment SETTLES the period
  /// whatever its size (paying the minimum closes it too) — anything left over
  /// rolls into the next period's `carriedOverAmount` instead of keeping this one
  /// payable, which is how a real credit card works. Zero while unpaid.
  paidAmount        Decimal   @default(0) @db.Decimal(18, 4)
  /// Debt brought forward from the PREVIOUS period, when that one was settled with
  /// less than its total. The period's total owed is its linked transactions plus
  /// this — the figure is kept here rather than as a fake movement so that
  /// "Sincronizar pagos" (which recomputes from real movements) can't erase it.
  carriedOverAmount Decimal   @default(0) @db.Decimal(18, 4)
  /// The period this one's leftover was rolled into (set at pay time when the
  /// payment didn't cover everything). Null when the period was paid in full.
  carriedToId       String?
  /// The bank account the payment was made from (never the credit account itself).
  paidFromAccountId String?
  /// The real EXPENSE transaction created on `paidFromAccount` at pay time.
  paidTransactionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account            BankAccount   @relation("CreditStatementAccount", fields: [accountId], references: [id], onDelete: Cascade)
  paidFromAccount    BankAccount?  @relation("CreditStatementPaidFrom", fields: [paidFromAccountId], references: [id], onDelete: SetNull)
  paidTransaction    Transaction?  @relation(fields: [paidTransactionId], references: [id], onDelete: SetNull)
  linkedTransactions Transaction[] @relation("CreditStatementLinkedTransactions")

  @@index([accountId])
  @@index([paidFromAccountId])
  @@map("credit-statement")
}

model CardAccount {
  id                    String   @id @default(cuid())
  accountId             String
  userId                String
  name                  String
  kind                  CardKind
  /// Only the last 4 digits are ever stored. Full PAN never transmitted/persisted.
  last4                 String
  expiryMonth           Int
  expiryYear            Int
  /// Whether the card is active (blocked/expired cards can be marked inactive).
  isActive              Boolean  @default(true)
  /// The first CREDIT-kind card added to the account (set automatically, never
  /// user-toggled). Its limit IS the account's own creditLimit/creditUsedInitial —
  /// edited from either side, same underlying value, no CardLimit row of its own.
  /// At most one true per account; irrelevant for DEBIT/PREPAID cards.
  isPrimary             Boolean  @default(false)
  /// A virtual card: no plastic. Issuers (MACH, Tenpo, Chek) hand out several of
  /// them on one account, often disposable, all spending the same balance.
  isVirtual             Boolean  @default(false)
  /// Issued to someone else (partner, child, employee) against the same account or
  /// credit line. Every charge is still the holder's, but knowing WHO spent is
  /// most of what a personal-finance app adds over the bank's own statement.
  isAdditional          Boolean  @default(false)
  /// Name embossed on the card, when it isn't the account owner's.
  cardholderName        String?
  /// Processing network, when known.
  network               CardNetwork?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  account      BankAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  walletItems     WalletItemDashboard[]
  transactions    Transaction[]
  limits          CardLimit[]
  installmentPlans InstallmentPlan[]

  @@index([accountId])
  @@index([userId])
  @@map("card-account")
}

/// A non-primary CREDIT card's own sub-limit (one per currency) — chosen instead of
/// sharing the account's pool ("tope propio" vs "cupo de la cuenta" in the UI). The
/// primary card never has CardLimit rows (its limit lives on BankAccount directly);
/// a non-primary card with no CardLimit rows is explicitly sharing the account pool.
model CardLimit {
  id          String   @id @default(cuid())
  cardId      String
  currency    String
  limitAmount Decimal  @db.Decimal(18, 4)
  /// Seed of already-used credit at creation, same convention as BankAccount.creditUsedInitial.
  usedInitial Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card CardAccount @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, currency])
  @@map("card-limit")
}

/// User-curated "wallet" on the dashboard. Each item pins EITHER a card or an
/// account (exactly one of cardId/accountId; enforced in the service). `order`
/// is the manual drag-and-drop position.
model WalletItemDashboard {
  id        String   @id @default(cuid())
  userId    String
  accountId String?
  cardId    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BankAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card    CardAccount? @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@unique([userId, cardId])
  @@index([userId])
  @@map("wallet-item-dashboard")
}

model Transaction {
  id                String          @id @default(cuid())
  userId            String
  bankAccountId     String?
  cardId            String?
  type              TransactionType
  amount            Decimal         @db.Decimal(18, 4)
  currency          String          @default("USD")
  occurredAt        DateTime
  category          String?
  description       String?
  observation       String?
  emisor            String?
  receptor          String?
  lugar             String?
  installmentPlanId String?
  /// The credit-pool billing period this movement contributes to, if any — assigned
  /// ONCE at creation (whichever statement was OPEN for the account at that moment),
  /// never reassigned by date on edit. See `CreditStatement`.
  creditStatementId String?
  /// Ties the two rows of a transfer together (EXPENSE on the source account +
  /// INCOME on the destination). `null` on ordinary income/expense. A row that
  /// carries it never has a card nor a credit statement (FR-019), and income/expense
  /// AGGREGATES must exclude these rows (`EXCLUDE_TRANSFERS`) — money moved between
  /// the user's own accounts is neither.
  transferGroupId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  card             CardAccount?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentPlan  InstallmentPlan?        @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  creditStatement  CreditStatement?        @relation("CreditStatementLinkedTransactions", fields: [creditStatementId], references: [id], onDelete: SetNull)
  /// The (at most one) CreditStatement this transaction was the payment FOR (reverse
  /// of `CreditStatement.paidTransaction`) — distinct from `creditStatement` above.
  paidForStatement CreditStatement?
  attachments      TransactionAttachment[]

  @@index([userId])
  @@index([bankAccountId])
  @@index([cardId])
  @@index([creditStatementId])
  @@index([occurredAt])
  @@index([installmentPlanId])
  @@index([category])
  @@index([transferGroupId])
  @@map("transaction")
}

/// A receipt/voucher file attached to a movement. The bytes live in object storage
/// (see `ObjectStoragePort`); this table only holds the pointer + metadata.
model TransactionAttachment {
  id            String   @id @default(cuid())
  userId        String
  transactionId String
  /// `u/<userId>/t/<transactionId>/<attachmentId>-<slug>` — derived from the id, not
  /// from the uploaded name, so two files named alike can coexist on one movement.
  storageKey    String   @unique
  fileName      String
  contentType   String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@map("transaction-attachment")
}

model InstallmentPlan {
  id                String               @id @default(cuid())
  userId            String
  title             String
  totalPrincipal    Decimal              @db.Decimal(18, 4)
  installmentCount  Int
  startDate         DateTime
  currency          String               @default("USD")
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  /// The card the purchase was made with, when it was one. Optional: a plan can
  /// also be a bank loan or an informal agreement with no card behind it.
  /// `SetNull` — deleting a card must not delete the debt it created.
  cardId            String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         CardAccount?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  payments     InstallmentPayment[]
  transactions Transaction[]

  @@index([userId])
  @@index([startDate])
  @@index([cardId])
  @@map("installment-plan")
}

model InstallmentPayment {
  id                String    @id @default(cuid())
  installmentPlanId String
  sequence          Int
  dueDate           DateTime
  amount            Decimal   @db.Decimal(18, 4)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@unique([installmentPlanId, sequence])
  @@index([installmentPlanId])
  @@index([dueDate])
  @@map("installment-payment")
}

enum InstallmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtDirection {
  OWED_TO_YOU
  YOU_OWE
}

model Debt {
  id                String               @id @default(cuid())
  userId            String
  direction         DebtDirection
  counterparty      String
  principal         Decimal              @db.Decimal(18, 4)
  currency          String               @default("USD")
  openedAt          DateTime
  dueAt             DateTime?
  interestApr       Decimal?             @db.Decimal(8, 4)
  notes             String?
  settledAt         DateTime?
  totalInstallments Int                  @default(1)
  paidInstallments  Int                  @default(0)
  installmentAmount Decimal?             @db.Decimal(18, 4)
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([openedAt])
  @@index([dueAt])
  @@map("debt")
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  targetAmount Decimal   @db.Decimal(18, 4)
  currency     String    @default("USD")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries SavingsEntry[]

  @@index([userId])
  @@index([deadline])
  @@map("savings-goal")
}

model SavingsEntry {
  id            String   @id @default(cuid())
  userId        String
  savingsGoalId String?
  amount        Decimal  @db.Decimal(18, 4)
  currency      String   @default("USD")
  contributedAt DateTime
  note          String?
  createdAt     DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([savingsGoalId])
  @@index([contributedAt])
  @@map("savings-entry")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Recurring expense (subscriptions, rent, periodic payments to people).
/// The next due date is computed from `anchorDate` + frequency × interval.
model RecurringExpense {
  id            String              @id @default(cuid())
  userId        String
  label         String
  amount        Decimal             @db.Decimal(18, 4)
  currency      String              @default("USD")
  category      String?
  frequency     RecurrenceFrequency
  /// Every N periods (1 = every week/month/year).
  interval      Int                 @default(1)
  /// First occurrence; later due dates step forward from here.
  anchorDate    DateTime
  bankAccountId String?
  active        Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankAccountId])
  @@index([active])
  @@map("recurring-expense")
}

enum InvestmentKind {
  ETF
  REMUNERATED_ACCOUNT
}

model Investment {
  id            String         @id @default(cuid())
  userId        String
  kind          InvestmentKind
  label         String
  currency      String         @default("USD")
  /// ETF: ticker symbol (e.g. VTI). Ignored for remunerated accounts.
  symbol        String?
  shares        Decimal?       @db.Decimal(24, 8)
  /// Remunerated / interest-bearing: nominal annual rate (e.g. 0.05 for 5%).
  annualRate    Decimal?       @db.Decimal(8, 6)
  principal     Decimal?       @db.Decimal(18, 4)
  bankAccountId String?
  openedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kind])
  @@index([symbol])
  @@index([bankAccountId])
  @@map("investment")
}

/// Alpha Vantage quote cache.
/// TTL (~24h): application treats rows with fetchedAt older than 24 hours as stale,
/// refetches from the API, then upserts by symbol.
model EtfPriceCache {
  id        String   @id @default(cuid())
  symbol    String   @unique
  fetchedAt DateTime
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal? @db.Decimal(24, 4)
  rawJson   Json?

  @@index([fetchedAt])
  @@map("etf-price-cache")
}

// --- Reference data: countries + banks ---

enum BankCategory {
  ESTABLISHED // Bancos establecidos en el país
  FOREIGN_BRANCH // Sucursales de bancos extranjeros
  STATE // Bancos estatales
}

/// ISO 3166-1 country reference. Banks (and future entities) link here.
model Country {
  id          String  @id @default(cuid())
  /// ISO 3166-1 alpha-2 (e.g. "CL"). Canonical code used for lookups/auditing.
  alpha2      String  @unique
  /// ISO 3166-1 alpha-3 (e.g. "CHL").
  alpha3      String  @unique
  /// ISO 3166-1 numeric (e.g. "152").
  numeric     String  @unique
  name        String
  /// International calling code, with leading "+" (e.g. "+56"). Used to prefix phone numbers so the
  /// user never has to type it — derived from their selected country instead.
  callingCode String?

  institutions    FinancialInstitution[]
  currencies      CountryCurrency[]
  identifierTypes CountryIdentifierType[]
  users           User[]

  @@map("country")
}

/// ISO 4217 currency reference (deduplicated by alpha code). `currency` string
/// fields across the app use these codes (CLP, USD, EUR…).
model Currency {
  id      String @id @default(cuid())
  /// ISO 4217 alpha code (e.g. "CLP").
  code    String @unique
  /// ISO 4217 numeric code (e.g. "152").
  numeric String
  /// Currency name (e.g. "Peso chileno").
  name    String

  countries CountryCurrency[]

  @@map("currency")
}

/// Which currencies a country uses (a country may have several; a currency is
/// shared by many countries). `isPrimary` marks the main one.
model CountryCurrency {
  id         String  @id @default(cuid())
  countryId  String
  currencyId String
  isPrimary  Boolean @default(false)

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([countryId, currencyId])
  @@index([currencyId])
  @@map("country-currency")
}

/// Which national identity document types a country supports (a country may support more than
/// one, e.g. a national id + passport). `isPrimary` marks the default/most common one.
model CountryIdentifierType {
  id             String         @id @default(cuid())
  countryId      String
  identifierType IdentifierType
  isPrimary      Boolean        @default(false)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, identifierType])
  @@map("country-identifier-type")
}

enum InstitutionKind {
  BANK // Banco establecido / estatal / sucursal extranjera
  /// Emisor no bancario de tarjetas (prepago y/o crédito). Una misma entidad puede
  /// tener ambas licencias — qué vende lo dice `institution-account-type`, no esto.
  NON_BANK_ISSUER
  /// Cooperativa de ahorro y crédito fiscalizada por la CMF. Ni banco ni emisora:
  /// capta ahorro de sus socios y presta, con su propia normativa.
  COOPERATIVE
}

/// Financial-institution registry: banks + non-bank card issuers. Scoped to a country.
/// (Chile: código SBIF/CMF for banks, código institucional for non-bank issuers.)
model FinancialInstitution {
  id        String          @id @default(cuid())
  countryId String
  kind      InstitutionKind @default(BANK)
  /// Institutional/regulator code (SBIF/CMF for banks; código institucional for issuers).
  code      String
  /// COMMERCIAL name — what the user recognises ("Tenpo", "Copec Pay"), which is
  /// often nothing like the registered entity. This is what the pickers show.
  name      String
  /// Registered legal name as it appears in the regulator's list ("Compañía Emisora
  /// de Medios de Pago Digitales S.A."). Searchable, never the primary label.
  legalName String?
  /// Bank sub-category; null for non-bank issuers.
  category  BankCategory?
  /// Other commercial brands the institution operates under.
  brands    String[]        @default([])
  /// Whether this institution sells to individuals at all. Corporate-only entities
  /// (foreign branches, BaaS providers) stay in the catalogue — the regulator lists
  /// them and historical data may point at them — but are hidden from the picker.
  retailFacing Boolean      @default(true)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  country      Country                  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  accounts     BankAccount[]
  accountTypes InstitutionAccountType[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([kind])
  @@map("financial-institution")
}

/// Which account products an institution actually offers (Tenpo: prepaid today, checking
/// tomorrow). Deliberately NOT derived from `kind`/`category`, which classify what the entity
/// IS (regulation), not what it SELLS. A join table rather than a scalar list because the
/// relation carries attributes of its own (`isPrimary`, and more to come) — same shape as
/// `CountryCurrency` / `CountryIdentifierType`. An institution with no rows here is treated as
/// "not catalogued yet" and offered for every account type.
model InstitutionAccountType {
  id            String      @id @default(cuid())
  institutionId String
  type          AccountType
  /// Marks the institution's flagship product (ordering only, no behavior).
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution FinancialInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, type])
  @@index([institutionId])
  @@map("institution-account-type")
}
