// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(uuid(7))
  name                 String?
  email                String?         @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  preferredCurrency    String          @default("CLP")
  locale               String          @default("es")
  dateFormat           String          @default("DD/MM/YYYY")
  theme                String          @default("dark")
  status               UserStatus      @default(ACTIVE)
  createdAt            DateTime        @default(now())
  /// Optional link to the user's country of residence (reuses the reference `Country` table).
  countryId            String?
  addressStreet        String?
  addressCity          String?
  addressRegion        String?
  addressPostalCode    String?
  birthDate            DateTime?
  /// National identity document type (RUT is Chile-specific; DNI/PASSPORT/OTHER cover other countries).
  identifierType       IdentifierType?
  /// The identifier's value. Format is only validated when identifierType is RUT (Chilean check digit).
  identifierValue      String?
  phone                String?
  /// Masks monetary amounts across the app when true (real effect — see PENDING.md for coverage scope).
  hideBalances         Boolean         @default(false)
  monthlyBudgetTarget  Decimal?        @db.Decimal(18, 4)
  /// Day of month (1-28) the user's financial cycle starts. Stored, not yet wired into "this month" calculations (see PENDING.md).
  billingCycleStartDay Int?
  /// Extra currencies the user wants tracked, on top of preferredCurrency. Selection only — no live FX conversion.
  extraCurrencies      String[]        @default([])
  /// % of monthlyBudgetTarget at which to warn the user. Stored for the Notifications UI; no real alert is sent yet.
  budgetAlertThreshold Int?            @default(80)

  country            Country?                @relation(fields: [countryId], references: [id], onDelete: SetNull)
  bankAccounts       BankAccount[]
  transactions       Transaction[]
  installmentPlans   InstallmentPlan[]
  debts              Debt[]
  savingsGoals       SavingsGoal[]
  savingsEntries     SavingsEntry[]
  investments        Investment[]
  recurringExpenses  RecurringExpense[]
  walletItems        WalletItemDashboard[]
  attachments        TransactionAttachment[]
  idempotencyRecords IdempotencyRecord[]

  @@index([countryId])
  @@map("user")
}

/// One ATTEMPT by the user, so a retry can be told apart from a new operation
/// (Constitution Principle VII, form (c)).
///
/// The key comes from the client and is opaque here: identity must NOT be derived
/// from the request's content, or two genuinely different operations that look
/// alike (two identical coffees on the same day) would collapse into one.
///
/// `@@unique([userId, key])` is not a validation — it IS the mutual exclusion.
/// Two simultaneous requests issue the same INSERT; Postgres lets one through and
/// the other gets P2002. No pessimistic lock, no row to lock beforehand.
///
/// Lifecycle: INSERT (IN_FLIGHT) → effect + COMPLETED in ONE transaction. Because
/// those two commit together, an IN_FLIGHT record ALWAYS means the effect did not
/// commit — which is what makes taking over a stale one safe rather than a gamble.
/// A rejected attempt is DELETED, never remembered: remembering it would leave the
/// user stuck repeating the same error.
model IdempotencyRecord {
  id             String            @id @default(uuid(7))
  userId         String
  /// Client-generated, opaque. A business value in its own column — NOT a row
  /// identifier (Principle VIII): this table's PK is a cuid like every other.
  key            String
  /// Which operation reserved the key, so replaying it against a different one is
  /// caught instead of answered with the first operation's response.
  operation      String
  /// SHA-256 of the canonicalized body. Used ONLY to detect "same key, different
  /// data" — never to decide whether two operations are the same.
  requestHash    String
  status         IdempotencyStatus @default(IN_FLIGHT)
  /// The exact first response, replayed verbatim. Re-reading the resource instead
  /// could return something else if it was edited in between.
  responseBody   Json?
  responseStatus Int?
  createdAt      DateTime          @default(now())
  /// createdAt + IDEMPOTENCY_RETENTION_HOURS. Swept by the daily cron.
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency-record")
}

enum IdempotencyStatus {
  IN_FLIGHT
  COMPLETED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// National identity document vocabulary. Which types a given country supports is data
/// (`CountryIdentifierType`), not fixed per-enum-value — a country may support more than one
/// (e.g. a national id + passport).
enum IdentifierType {
  RUT
  DNI
  PASSPORT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING // Corriente
  SIGHT // Vista / Cuenta RUT
  SAVINGS // Ahorro
  INVESTMENT // Inversiones (Fintual)
  CREDIT_CARD // Cuenta de tarjeta de crédito: deuda rotativa con su propia facturación
  PREPAID // Cuenta prepago: fondos provisionados (emisor bancario o no bancario), sin crédito
  CASH // Efectivo
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

/// Processing network a card runs on. Redcompra is the Chilean domestic one (still
/// the only network on some older debit cards).
enum CardNetwork {
  VISA
  MASTERCARD
  AMEX
  REDCOMPRA
  OTHER
}

/// Physical payment instruments (the "plastic"). Prepaid included.
enum CardKind {
  CREDIT
  DEBIT
  PREPAID
}

model BankAccount {
  id                String        @id @default(uuid(7))
  userId            String
  name              String
  type              AccountType   @default(CHECKING)
  status            AccountStatus @default(ACTIVE)
  currency          String        @default("CLP")
  /// Free-text institution name (mirrors the selected bank's name; kept for display / manual entry).
  institution       String?
  /// Optional link to a registered FinancialInstitution (the "institution" selector). Null for cash/manual.
  institutionId     String?
  /// Bank account number (free text, stored/displayed in full — NOT a card PAN).
  /// Its format is the country's business: free text in Chile, a 22-digit CBU/CVU
  /// in Argentina (validated in the contract, never re-formatted here).
  accountNumber     String?
  /// The human-readable alias that identifies the account for transfers where the
  /// market has one (Argentina's `mate.tango.mp`). Null everywhere else.
  accountAlias      String?
  /// How far below zero this account may go — the "línea de sobregiro" a bank grants
  /// on a current account. 0 = no overdraft. It is a property OF the cash account
  /// (the money is consumed automatically when the balance hits zero), not a product
  /// with movements of its own, which is why it is a column and not an account type.
  overdraftLimit    Decimal       @default(0) @db.Decimal(18, 4)
  /// Regulatory/contractual CEILING on the balance this account may hold — the mirror
  /// image of `overdraftLimit`. Chile's CuentaRUT and the prepaid accounts under CMF
  /// rules have a maximum they can store; an income past it is what the bank itself
  /// would reject. Null = no ceiling declared, and then nothing is refused.
  balanceCeiling    Decimal?      @db.Decimal(18, 4)
  /// User-set seed balance (own funds). For CREDIT_CARD accounts typically 0.
  initialBalance    Decimal       @default(0) @db.Decimal(18, 4)
  /// Reconciled/cached balance = initialBalance + Σincome − Σexpense.
  currentBalance    Decimal       @default(0) @db.Decimal(18, 4)
  /// Credit pool for CREDIT_CARD accounts (shared by all its cards). 0 otherwise.
  creditLimit       Decimal       @default(0) @db.Decimal(18, 4)
  /// Seed of already-used credit at account creation. Immutable baseline used only to
  /// initialize `creditUsed` — never recomputed into afterward.
  creditUsedInitial Decimal       @default(0) @db.Decimal(18, 4)
  /// Persisted, live "used" balance for the account's shared credit pool. Seeded from
  /// `creditUsedInitial` at creation; incremented/decremented by transactions (see
  /// TransactionsService) and decremented when a `CreditStatement` is paid.
  /// No longer derived/recomputed on read.
  creditUsed        Decimal       @default(0) @db.Decimal(18, 4)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialInstitution FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  transactions         Transaction[]
  investments          Investment[]
  cards                CardAccount[]
  recurringExpenses    RecurringExpense[]
  walletItems          WalletItemDashboard[]
  /// Statements belonging to THIS credit account's pool.
  creditStatements     CreditStatement[]     @relation("CreditStatementAccount")
  /// Statements (of some OTHER credit account) paid FROM this account.
  paidStatements       CreditStatement[]     @relation("CreditStatementPaidFrom")
  billingSettings      BillingSettings?
  /// Installment plans that are paid FROM this account.
  paidInstallmentPlans InstallmentPlan[]     @relation("InstallmentPlanPaymentAccount")
  /// Debts that record this account as where they'd be paid from/to.
  linkedDebts          Debt[]                @relation("DebtPaymentAccount")

  @@index([userId])
  @@index([status])
  @@index([institutionId])
  @@map("bank-account")
}

enum BillingPaymentMethod {
  MANUAL
  AUTOMATIC
}

/// How `billingCycleDay` is counted. BUSINESS_DAY (días hábiles) counts only
/// Mon-Fri Chilean business days (Saturdays, Sundays and public holidays don't
/// count) — e.g. BCI's real-world "20 días hábiles" after the previous period
/// closed. CALENDAR_DAY is the original fixed day-of-month behavior.
enum BillingCycleType {
  BUSINESS_DAY
  CALENDAR_DAY
}

/// Billing configuration for an account's shared credit pool — split out from
/// `BankAccount` (1:1) so it can be reviewed/maintained/searched independently
/// instead of growing the account table with every billing-related field.
model BillingSettings {
  id                    String               @id @default(uuid(7))
  accountId             String               @unique
  /// Statement cut-off. Meaning depends on `cycleType`: a day-of-month (1-28)
  /// for CALENDAR_DAY, or a count of business days for BUSINESS_DAY. Drives
  /// automatic statement generation (cron + manual "Generar facturación"
  /// button) — when this boundary passes, the account's currently OPEN
  /// `CreditStatement` (if any) is closed.
  billingCycleDay       Int?
  /// Días hábiles (default for new accounts) or a fixed day-of-month.
  cycleType             BillingCycleType     @default(BUSINESS_DAY)
  /// Whether the user intends to pay the credit statement manually or automatically.
  /// Stored preference only — AUTOMATIC is currently LOCKED in the UI (not selectable):
  /// the automatic-payment execution isn't built yet, so no automatic payment can be
  /// scheduled safely (see PENDING.md). Column kept for when that ships.
  paymentMethod         BillingPaymentMethod @default(MANUAL)
  /// When payment is due, counted from a period's own close. Meaning depends on
  /// `paymentDueCycleType`: a count of business days (e.g. BCI's real-world "3
  /// días hábiles") for BUSINESS_DAY, or a fixed day-of-month for CALENDAR_DAY.
  /// Null = no due date configured/shown.
  paymentDueDay         Int?
  /// Independent of `cycleType` (generation): an issuer can generate on a fixed
  /// day-of-month but still owe payment N business days later, or vice versa.
  paymentDueCycleType   BillingCycleType     @default(BUSINESS_DAY)
  /// Percentage of a statement that counts as its MINIMUM payment (e.g. 5 = 5%).
  /// There is no universal rule for this — each issuer sets its own — so it is
  /// per-account configuration rather than a constant. Null = this account has no
  /// minimum defined, and the UI offers no "minimum" option for it.
  minimumPaymentPercent Decimal?             @db.Decimal(5, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("billing-settings")
}

/// A billing period for an account's shared credit pool ("facturación"). Transactions
/// that contribute to the pool are linked here live, as they happen
/// (`Transaction.creditStatementId`) — while unpaid, the amount is NOT stored here but
/// computed on read as the live sum of linked transactions (see
/// `AccountsService`/`BillingGenerationService`). Derived status (not persisted):
/// OPEN (`closedAt` null, still accumulating) → PENDING (`closedAt` set by
/// generation, awaiting payment) → PAID (`paidAt` set).
model CreditStatement {
  id                String    @id @default(uuid(7))
  accountId         String
  /// When this period started accumulating (the previous statement's `closedAt`, or
  /// the account's `createdAt` for the very first one).
  periodStart       DateTime
  /// Sealed by generation (cron/manual button) once `billingCycleDay` passes — null
  /// while still open/accumulating.
  closedAt          DateTime?
  /// Set when paid. Only then is `amount` meaningful (frozen at pay time) and only
  /// then can `amount` be corrected manually (no cascade to the linked payment
  /// transaction or to `creditUsed` — a deliberate, personal-use simplification).
  paidAt            DateTime?
  /// Frozen snapshot amount, set at pay time. Null/ignored while unpaid — the
  /// live amount is computed by summing linked transactions instead.
  amount            Decimal?  @db.Decimal(18, 4)
  /// How much was actually paid for this period. A payment SETTLES the period
  /// whatever its size (paying the minimum closes it too) — anything left over
  /// rolls into the next period's `carriedOverAmount` instead of keeping this one
  /// payable, which is how a real credit card works. Zero while unpaid.
  paidAmount        Decimal   @default(0) @db.Decimal(18, 4)
  /// Debt brought forward from the PREVIOUS period, when that one was settled with
  /// less than its total. The period's total owed is its linked transactions plus
  /// this — the figure is kept here rather than as a fake movement so that
  /// "Sincronizar pagos" (which recomputes from real movements) can't erase it.
  carriedOverAmount Decimal   @default(0) @db.Decimal(18, 4)
  /// The period this one's leftover was rolled into (set at pay time when the
  /// payment didn't cover everything). Null when the period was paid in full.
  carriedToId       String?
  /// The bank account the payment was made from (never the credit account itself).
  paidFromAccountId String?
  /// The real EXPENSE transaction created on `paidFromAccount` at pay time.
  paidTransactionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account            BankAccount          @relation("CreditStatementAccount", fields: [accountId], references: [id], onDelete: Cascade)
  paidFromAccount    BankAccount?         @relation("CreditStatementPaidFrom", fields: [paidFromAccountId], references: [id], onDelete: SetNull)
  paidTransaction    Transaction?         @relation(fields: [paidTransactionId], references: [id], onDelete: SetNull)
  linkedTransactions Transaction[]        @relation("CreditStatementLinkedTransactions")
  /// The instalments this period charged (spec 014). A period's total owed is its
  /// linked transactions PLUS its carry-over PLUS these — the third summand is not a
  /// movement, for the same reason `carriedOverAmount` isn't one.
  billedInstallments InstallmentPayment[]

  @@index([accountId])
  @@index([paidFromAccountId])
  @@map("credit-statement")
}

model CardAccount {
  id             String       @id @default(uuid(7))
  accountId      String
  userId         String
  name           String
  kind           CardKind
  /// Only the last 4 digits are ever stored. Full PAN never transmitted/persisted.
  last4          String
  expiryMonth    Int
  expiryYear     Int
  /// Whether the card is active (blocked/expired cards can be marked inactive).
  isActive       Boolean      @default(true)
  /// The first CREDIT-kind card added to the account (set automatically, never
  /// user-toggled). Its limit IS the account's own creditLimit/creditUsedInitial —
  /// edited from either side, same underlying value, no CardLimit row of its own.
  /// At most one true per account; irrelevant for DEBIT/PREPAID cards.
  isPrimary      Boolean      @default(false)
  /// A virtual card: no plastic. Issuers (MACH, Tenpo, Chek) hand out several of
  /// them on one account, often disposable, all spending the same balance.
  isVirtual      Boolean      @default(false)
  /// Issued to someone else (partner, child, employee) against the same account or
  /// credit line. Every charge is still the holder's, but knowing WHO spent is
  /// most of what a personal-finance app adds over the bank's own statement.
  isAdditional   Boolean      @default(false)
  /// Name embossed on the card, when it isn't the account owner's.
  cardholderName String?
  /// Processing network, when known.
  network        CardNetwork?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  account           BankAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  walletItems       WalletItemDashboard[]
  transactions      Transaction[]
  limits            CardLimit[]
  installmentPlans  InstallmentPlan[]
  recurringExpenses RecurringExpense[]

  @@index([accountId])
  @@index([userId])
  @@map("card-account")
}

/// A non-primary CREDIT card's own sub-limit (one per currency) — chosen instead of
/// sharing the account's pool ("tope propio" vs "cupo de la cuenta" in the UI). The
/// primary card never has CardLimit rows (its limit lives on BankAccount directly);
/// a non-primary card with no CardLimit rows is explicitly sharing the account pool.
model CardLimit {
  id          String   @id @default(uuid(7))
  cardId      String
  currency    String
  limitAmount Decimal  @db.Decimal(18, 4)
  /// Seed of already-used credit at creation, same convention as BankAccount.creditUsedInitial.
  usedInitial Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card CardAccount @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, currency])
  @@map("card-limit")
}

/// User-curated "wallet" on the dashboard. Each item pins EITHER a card or an
/// account (exactly one of cardId/accountId; enforced in the service). `order`
/// is the manual drag-and-drop position.
model WalletItemDashboard {
  id        String   @id @default(uuid(7))
  userId    String
  accountId String?
  cardId    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BankAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card    CardAccount? @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@unique([userId, cardId])
  @@index([userId])
  @@map("wallet-item-dashboard")
}

/// A charge the ISSUER applies to a credit account itself — interest on a revolved
/// balance, an annual fee, insurance — as opposed to a purchase someone made with a
/// card. It has no card by definition, and the app never computes it: it is read off
/// the statement and recorded, which is what keeps the carried-over balance square
/// with the bank's own figure without this domain inventing interest rates.
model Transaction {
  id                 String          @id @default(uuid(7))
  userId             String
  bankAccountId      String?
  cardId             String?
  /// True for an issuer charge on the credit account itself — interest on a revolved
  /// balance, an annual fee, insurance. EXPENSE, no card, only on a CREDIT_CARD
  /// account, and it feeds the credit pool. The app never COMPUTES it: it is read off
  /// the statement and recorded, which is what keeps the carried-over balance square
  /// with the bank without this domain inventing interest rates.
  financeCharge      Boolean         @default(false)
  type               TransactionType
  amount             Decimal         @db.Decimal(18, 4)
  currency           String          @default("USD")
  occurredAt         DateTime
  category           String?
  description        String?
  observation        String?
  emisor             String?
  receptor           String?
  lugar              String?
  installmentPlanId  String?
  /// The credit-pool billing period this movement contributes to, if any — assigned
  /// ONCE at creation (whichever statement was OPEN for the account at that moment),
  /// never reassigned by date on edit. See `CreditStatement`.
  creditStatementId  String?
  /// Ties the two rows of a transfer together (EXPENSE on the source account +
  /// INCOME on the destination). `null` on ordinary income/expense. A row that
  /// carries it never has a card nor a credit statement (FR-019), and income/expense
  /// AGGREGATES must exclude these rows (`EXCLUDE_TRANSFERS`) — money moved between
  /// the user's own accounts is neither.
  transferGroupId    String?
  /// The person-to-person `Debt` this movement is a payment for/against — set by
  /// `RegisterDebtPaymentHandler`/`SettleDebtHandler`, the same way `installmentPlanId`
  /// is set by their `installment-plan` counterparts. Lets the Movements view say
  /// "viene de una deuda" instead of leaving the movement looking manual.
  debtId             String?
  /// The `RecurringExpense` this movement was generated FOR — set only when a
  /// real automatic-generation mechanism writes the row (none exists yet; see
  /// `RecurringExpense`'s own doc comment). Seeded by hand today so the
  /// "historial de ocurrencias" detail view has real rows to read instead of
  /// always showing empty.
  recurringExpenseId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount         BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  card                CardAccount?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentPlan     InstallmentPlan?        @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  debt                Debt?                   @relation(fields: [debtId], references: [id], onDelete: SetNull)
  recurringExpense    RecurringExpense?       @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  creditStatement     CreditStatement?        @relation("CreditStatementLinkedTransactions", fields: [creditStatementId], references: [id], onDelete: SetNull)
  /// The (at most one) CreditStatement this transaction was the payment FOR (reverse
  /// of `CreditStatement.paidTransaction`) — distinct from `creditStatement` above.
  paidForStatement    CreditStatement?
  attachments         TransactionAttachment[]
  /// The (at most one) installment this movement is the payment FOR. Its presence is
  /// what makes this movement read-only from the Movements view: it is corrected by
  /// undoing and re-paying the installment, never edited in place.
  installmentPayments InstallmentPayment[]

  @@index([userId])
  @@index([bankAccountId])
  @@index([cardId])
  @@index([creditStatementId])
  @@index([occurredAt])
  @@index([installmentPlanId])
  @@index([category])
  @@index([transferGroupId])
  @@index([debtId])
  @@index([recurringExpenseId])
  @@map("transaction")
}

/// A receipt/voucher file attached to a movement. The bytes live in object storage
/// (see `ObjectStoragePort`); this table only holds the pointer + metadata.
model TransactionAttachment {
  id            String   @id @default(uuid(7))
  userId        String
  transactionId String
  /// `u/<userId>/t/<transactionId>/<attachmentId>-<slug>` — derived from the id, not
  /// from the uploaded name, so two files named alike can coexist on one movement.
  storageKey    String   @unique
  fileName      String
  contentType   String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@map("transaction-attachment")
}

model InstallmentPlan {
  id                String               @id @default(uuid(7))
  userId            String
  title             String
  totalPrincipal    Decimal              @db.Decimal(18, 4)
  installmentCount  Int
  startDate         DateTime
  currency          String               @default("USD")
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  /// The card the purchase was made with, when it was one. Optional: a plan can
  /// also be a bank loan or an informal agreement with no card behind it.
  /// `SetNull` — deleting a card must not delete the debt it created.
  cardId            String?
  /// Free text, drawn from the SAME repertoire as `Transaction.category` — not a
  /// catalogue of its own. Purely descriptive: the row's icon is derived from it
  /// with the shared category→icon map, and no calculation reads it.
  category          String?
  /// The account whose money pays this plan's installments — remembered so each
  /// payment form comes pre-filled. `SetNull`: deleting the account must not delete
  /// the debt, it only makes the form ask again. Changing it affects FUTURE payments
  /// only; the ones already recorded keep the account they were paid from.
  /// Always null on a plan bought with a CREDIT card (that debt is already in the
  /// card's own statement, so its installments generate no movement).
  paymentAccountId  String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           CardAccount?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  paymentAccount BankAccount?         @relation("InstallmentPlanPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  payments       InstallmentPayment[]
  transactions   Transaction[]

  @@index([userId])
  @@index([startDate])
  @@index([cardId])
  @@index([paymentAccountId])
  @@map("installment-plan")
}

model InstallmentPayment {
  id                String    @id @default(uuid(7))
  installmentPlanId String
  sequence          Int
  dueDate           DateTime
  /// The SCHEDULED amount. Never rewritten after the plan is created — paying more
  /// or less does not touch the calendar, it produces a carry-over instead.
  amount            Decimal   @db.Decimal(18, 4)
  /// The REAL date of payment (which may be later than `dueDate`). "Paid" is
  /// `paidAt !== null` — NEVER `paidAmount !== null`: an installment marked paid
  /// before this feature has a date and no amount.
  paidAt            DateTime?
  /// What was ACTUALLY paid, which may differ from `amount`. Null on an installment
  /// paid before this feature existed = "paid, real amount unknown".
  paidAmount        Decimal?  @db.Decimal(18, 4)
  /// What the PREVIOUS installment failed to cover and this one inherits; NEGATIVE
  /// when the previous one was overpaid. What this installment owes is
  /// `amount + carriedOverAmount`. Persisted rather than derived so that undoing a
  /// payment can reverse exactly what that payment caused — the same reasoning, and
  /// the same mechanism, as `CreditStatement.carriedOverAmount`.
  carriedOverAmount Decimal   @default(0) @db.Decimal(18, 4)
  /// The real expense backing this installment. `SetNull` — if the movement is
  /// removed by any route, the installment is left intact and still undoable, never
  /// deleted along with it.
  transactionId     String?
  /// The billing period that CHARGED this installment (spec 014). Null = not billed
  /// yet. Persisted rather than derived from `dueDate` falling inside a period's
  /// window because periods are created LAZILY — a cycle with no card activity
  /// produces no period at all, so those windows have gaps, and an installment
  /// falling in one would be either missed or swept into a later period together
  /// with the next. This column is what makes "billed exactly once" true by
  /// construction: selection is `creditStatementId IS NULL`.
  /// `SetNull`, never `Cascade`: deleting a period must never delete a row of the
  /// plan's schedule.
  /// Only ever set for plans bought with a CREDIT card. Every other plan goes
  /// straight from scheduled to paid, one installment at a time, as before.
  creditStatementId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan            InstallmentPlan  @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  creditStatement CreditStatement? @relation(fields: [creditStatementId], references: [id], onDelete: SetNull)

  @@unique([installmentPlanId, sequence])
  @@index([installmentPlanId])
  @@index([dueDate])
  @@index([transactionId])
  @@index([creditStatementId])
  @@map("installment-payment")
}

enum InstallmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtDirection {
  OWED_TO_YOU
  YOU_OWE
}

model Debt {
  id                       String               @id @default(uuid(7))
  userId                   String
  direction                DebtDirection
  counterparty             String
  principal                Decimal              @db.Decimal(18, 4)
  currency                 String               @default("USD")
  openedAt                 DateTime
  dueAt                    DateTime?
  interestApr              Decimal?             @db.Decimal(8, 4)
  /// Short label for the debt ("Título" in the UI) — what every list/detail
  /// view actually displays as its name. Was called `notes` before it split
  /// from the free-text `notes` column below (there was nothing to fuse: the
  /// real model only ever had this one field, doing double duty as both).
  title                    String?
  /// Genuine free-text notes/observación — separate from `title` above, same
  /// pairing a movement's own Descripción + Observación already has.
  notes                    String?
  settledAt                DateTime?
  totalInstallments        Int                  @default(1)
  paidInstallments         Int                  @default(0)
  installmentAmount        Decimal?             @db.Decimal(18, 4)
  frequency                InstallmentFrequency @default(MONTHLY)
  frequencyInterval        Int                  @default(1)
  /// The bank account this debt is associated with — the payment panel's
  /// DEFAULT suggestion for `register-payment`/`settle`'s own `accountId`
  /// body field, which may differ (the user can pick another account there).
  /// Nullable/`SetNull` because a debt can outlive the account it pointed to.
  paymentAccountId         String?
  /// The three columns below record what `register-payment`/`settle` most
  /// recently did to a REAL account, so `undoPayment`/`unsettle` can reverse
  /// exactly that movement — plain bookkeeping columns, not FKs (an account
  /// this points to may since have been deleted, and the record should
  /// survive that). Null on a debt with no payment yet, or one settled/paid
  /// before this feature existed (its `undoPayment`/`unsettle` then only
  /// reverts the counter/date, same as before — no movement to reverse).
  lastPaymentTransactionId String?
  lastPaymentAccountId     String?
  lastPaymentAmount        Decimal?             @db.Decimal(18, 4)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount BankAccount?  @relation("DebtPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  /// Movements recorded against this debt (see `Transaction.debtId`) — every real
  /// payment `register-payment`/`settle` created, not just the most recent one.
  transactions   Transaction[]

  @@index([userId])
  @@index([openedAt])
  @@index([dueAt])
  @@index([paymentAccountId])
  @@map("debt")
}

model SavingsGoal {
  id           String    @id @default(uuid(7))
  userId       String
  title        String
  targetAmount Decimal   @db.Decimal(18, 4)
  currency     String    @default("USD")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries SavingsEntry[]

  @@index([userId])
  @@index([deadline])
  @@map("savings-goal")
}

model SavingsEntry {
  id            String   @id @default(uuid(7))
  userId        String
  savingsGoalId String?
  amount        Decimal  @db.Decimal(18, 4)
  currency      String   @default("USD")
  contributedAt DateTime
  note          String?
  createdAt     DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([savingsGoalId])
  @@index([contributedAt])
  @@map("savings-entry")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Recurring expense (subscriptions, rent, periodic payments to people).
/// The next due date is computed from `anchorDate` + frequency × interval.
model RecurringExpense {
  id            String              @id @default(uuid(7))
  userId        String
  label         String
  amount        Decimal             @db.Decimal(18, 4)
  currency      String              @default("USD")
  category      String?
  frequency     RecurrenceFrequency
  /// Every N periods (1 = every week/month/year).
  interval      Int                 @default(1)
  /// First occurrence; later due dates step forward from here.
  anchorDate    DateTime
  bankAccountId String?
  /// The card this series is paid with, when it's paid by card rather than a
  /// plain transfer out of `bankAccountId` — purely informational, same spirit
  /// as `Debt.paymentAccountId`; nothing here moves real money. `SetNull`:
  /// deleting the card must not delete the series it was attached to.
  cardId        String?
  active        Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  card         CardAccount?  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  /// Movements generated FOR this series — see `Transaction.recurringExpenseId`.
  transactions Transaction[]

  @@index([userId])
  @@index([bankAccountId])
  @@index([cardId])
  @@index([active])
  @@map("recurring-expense")
}

enum InvestmentKind {
  ETF
  REMUNERATED_ACCOUNT
}

model Investment {
  id            String         @id @default(uuid(7))
  userId        String
  kind          InvestmentKind
  label         String
  currency      String         @default("USD")
  /// ETF: ticker symbol (e.g. VTI). Ignored for remunerated accounts.
  symbol        String?
  shares        Decimal?       @db.Decimal(24, 8)
  /// Remunerated / interest-bearing: nominal annual rate (e.g. 0.05 for 5%).
  annualRate    Decimal?       @db.Decimal(8, 6)
  principal     Decimal?       @db.Decimal(18, 4)
  bankAccountId String?
  openedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kind])
  @@index([symbol])
  @@index([bankAccountId])
  @@map("investment")
}

/// Alpha Vantage quote cache.
/// TTL (~24h): application treats rows with fetchedAt older than 24 hours as stale,
/// refetches from the API, then upserts by symbol.
model EtfPriceCache {
  id        String   @id @default(uuid(7))
  symbol    String   @unique
  fetchedAt DateTime
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal? @db.Decimal(24, 4)
  rawJson   Json?

  @@index([fetchedAt])
  @@map("etf-price-cache")
}

// --- Reference data: countries + banks ---

enum BankCategory {
  ESTABLISHED // Bancos establecidos en el país
  FOREIGN_BRANCH // Sucursales de bancos extranjeros
  STATE // Bancos estatales
}

/// ISO 3166-1 country reference. Banks (and future entities) link here.
model Country {
  id          String  @id @default(uuid(7))
  /// ISO 3166-1 alpha-2 (e.g. "CL"). Canonical code used for lookups/auditing.
  alpha2      String  @unique
  /// ISO 3166-1 alpha-3 (e.g. "CHL").
  alpha3      String  @unique
  /// ISO 3166-1 numeric (e.g. "152").
  numeric     String  @unique
  name        String
  /// International calling code, with leading "+" (e.g. "+56"). Used to prefix phone numbers so the
  /// user never has to type it — derived from their selected country instead.
  callingCode String?

  institutions    FinancialInstitution[]
  currencies      CountryCurrency[]
  identifierTypes CountryIdentifierType[]
  users           User[]

  @@map("country")
}

/// ISO 4217 currency reference (deduplicated by alpha code). `currency` string
/// fields across the app use these codes (CLP, USD, EUR…).
model Currency {
  id      String  @id @default(uuid(7))
  /// ISO 4217 alpha code (e.g. "CLP").
  code    String  @unique
  /// ISO 4217 numeric code (e.g. "152").
  numeric String
  /// Currency name (e.g. "Peso chileno").
  name    String
  /// Display symbol ("$", "UF", "S/", "€"…), stored rather than derived —
  /// `Intl.NumberFormat` only resolves a currency's native symbol when given a
  /// LOCALE that matches its own region (S/ needs `es-PE`, € needs a European
  /// locale), and this app renders every amount in the user's own UI locale
  /// regardless of the money's currency, which is what made CLF/UF and USD
  /// come out wrong or ambiguous under a single fixed `es-CL` locale. Nullable
  /// for a currency that genuinely has no symbol at all — the reading then
  /// falls back to the bare ISO code. Dynamic ON PURPOSE: adding a new
  /// currency here (reactivating the regional catalogue,
  /// `docs/CATALOGO_REGIONAL.md`) makes its symbol show up everywhere with no
  /// code change, instead of a new special case in `currencySymbol`.
  symbol  String?

  countries CountryCurrency[]

  @@map("currency")
}

/// Which currencies a country uses (a country may have several; a currency is
/// shared by many countries). `isPrimary` marks the main one.
model CountryCurrency {
  id         String  @id @default(uuid(7))
  countryId  String
  currencyId String
  isPrimary  Boolean @default(false)

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([countryId, currencyId])
  @@index([currencyId])
  @@map("country-currency")
}

/// Which national identity document types a country supports (a country may support more than
/// one, e.g. a national id + passport). `isPrimary` marks the default/most common one.
model CountryIdentifierType {
  id             String         @id @default(uuid(7))
  countryId      String
  identifierType IdentifierType
  isPrimary      Boolean        @default(false)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, identifierType])
  @@map("country-identifier-type")
}

enum InstitutionKind {
  BANK // Banco establecido / estatal / sucursal extranjera
  /// Emisor no bancario de tarjetas (prepago y/o crédito). Una misma entidad puede
  /// tener ambas licencias — qué vende lo dice `institution-account-type`, no esto.
  NON_BANK_ISSUER
  /// Cooperativa de ahorro y crédito fiscalizada por la CMF. Ni banco ni emisora:
  /// capta ahorro de sus socios y presta, con su propia normativa.
  COOPERATIVE
  /// Proveedor de servicios de pago: mantiene cuentas de pago (dinero electrónico)
  /// sin ser banco y sin que su producto sea necesariamente una tarjeta. Es la
  /// figura de los PSP argentinos (CVU), las SEDPE colombianas, las EEDE peruanas
  /// y las EMPE paraguayas — mismo rol, cuatro nombres regulatorios.
  PAYMENT_PROVIDER
  /// Administradora general de fondos / corredora: administra dinero de terceros
  /// invertido en fondos o instrumentos. No capta depósitos ni emite medios de pago,
  /// así que su único producto es la cuenta de inversión (Fintual, LarrainVial,
  /// Banchile Inversiones). Un banco que vende fondos por su filial NO cambia de
  /// `kind` — declara el producto INVESTMENT, que es lo que el usuario reconoce.
  FUND_MANAGER
}

/// Financial-institution registry: banks + non-bank card issuers. Scoped to a country.
/// (Chile: código SBIF/CMF for banks, código institucional for non-bank issuers.)
model FinancialInstitution {
  id           String          @id @default(uuid(7))
  countryId    String
  kind         InstitutionKind @default(BANK)
  /// Institutional/regulator code (SBIF/CMF for banks; código institucional for issuers).
  code         String
  /// COMMERCIAL name — what the user recognises ("Tenpo", "Copec Pay"), which is
  /// often nothing like the registered entity. This is what the pickers show.
  name         String
  /// Registered legal name as it appears in the regulator's list ("Compañía Emisora
  /// de Medios de Pago Digitales S.A."). Searchable, never the primary label.
  legalName    String?
  /// Bank sub-category; null for non-bank issuers.
  category     BankCategory?
  /// Other commercial brands the institution operates under.
  brands       String[]        @default([])
  /// Whether this institution sells to individuals at all. Corporate-only entities
  /// (foreign branches, BaaS providers) stay in the catalogue — the regulator lists
  /// them and historical data may point at them — but are hidden from the picker.
  retailFacing Boolean         @default(true)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  country      Country                  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  accounts     BankAccount[]
  accountTypes InstitutionAccountType[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([kind])
  @@map("financial-institution")
}

/// Which account products an institution actually offers (Tenpo: prepaid today, checking
/// tomorrow). Deliberately NOT derived from `kind`/`category`, which classify what the entity
/// IS (regulation), not what it SELLS. A join table rather than a scalar list because the
/// relation carries attributes of its own (`isPrimary`, and more to come) — same shape as
/// `CountryCurrency` / `CountryIdentifierType`. An institution with no rows here is treated as
/// "not catalogued yet" and offered for every account type.
model InstitutionAccountType {
  id            String      @id @default(uuid(7))
  institutionId String
  type          AccountType
  /// Marks the institution's flagship product (ordering only, no behavior).
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution FinancialInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, type])
  @@index([institutionId])
  @@map("institution-account-type")
}
