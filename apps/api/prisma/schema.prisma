// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js / NextAuth (Prisma adapter) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  accounts         Account[]
  sessions         Session[]
  bankAccounts      BankAccount[]
  transactions      Transaction[]
  installmentPlans  InstallmentPlan[]
  debts             Debt[]
  savingsGoals      SavingsGoal[]
  savingsEntries    SavingsEntry[]
  investments       Investment[]
  recurringExpenses RecurringExpense[]
  walletItems       WalletItem[]
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  VISTA
  CREDIT_CARD
  DEBIT_CARD
  CASH
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum CardKind {
  CREDIT
  DEBIT
}

model BankAccount {
  id             String        @id @default(cuid())
  userId         String
  name           String
  type           AccountType   @default(OTHER)
  status         AccountStatus @default(ACTIVE)
  currency       String        @default("USD")
  institution    String?
  /// User-set seed balance.
  initialBalance Decimal       @default(0) @db.Decimal(18, 4)
  /// Reconciled/cached balance = initialBalance + Σincome − Σexpense.
  currentBalance Decimal       @default(0) @db.Decimal(18, 4)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  investments       Investment[]
  cards             Card[]
  recurringExpenses RecurringExpense[]
  walletItems       WalletItem[]

  @@index([userId])
  @@index([status])
}

model Card {
  id          String   @id @default(cuid())
  accountId   String
  userId      String
  name        String
  kind        CardKind
  /// Only the last 4 digits are ever stored. Full PAN never transmitted/persisted.
  last4       String
  expiryMonth Int
  expiryYear  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  limits      CardLimit[]
  walletItems WalletItem[]

  @@index([accountId])
  @@index([userId])
}

/// User-curated "wallet" on the dashboard. Each item pins EITHER a card or an
/// account (exactly one of cardId/accountId; enforced in the service). `order`
/// is the manual drag-and-drop position.
model WalletItem {
  id        String   @id @default(cuid())
  userId    String
  accountId String?
  cardId    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BankAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card    Card?        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@unique([userId, cardId])
  @@index([userId])
}

model CardLimit {
  id       String  @id @default(cuid())
  cardId   String
  currency String
  limit    Decimal @db.Decimal(18, 4)
  used     Decimal @default(0) @db.Decimal(18, 4)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, currency])
  @@index([cardId])
}

model Transaction {
  id                String          @id @default(cuid())
  userId            String
  bankAccountId     String?
  type              TransactionType
  amount            Decimal         @db.Decimal(18, 4)
  currency          String          @default("USD")
  occurredAt        DateTime
  category          String?
  description       String?
  observation       String?
  emisor            String?
  receptor          String?
  lugar             String?
  installmentPlanId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankAccountId])
  @@index([occurredAt])
  @@index([installmentPlanId])
  @@index([category])
}

model InstallmentPlan {
  id               String   @id @default(cuid())
  userId           String
  title            String
  totalPrincipal   Decimal  @db.Decimal(18, 4)
  installmentCount Int
  startDate        DateTime
  currency          String               @default("USD")
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     InstallmentPayment[]
  transactions Transaction[]

  @@index([userId])
  @@index([startDate])
}

model InstallmentPayment {
  id                String    @id @default(cuid())
  installmentPlanId String
  sequence          Int
  dueDate           DateTime
  amount            Decimal   @db.Decimal(18, 4)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@unique([installmentPlanId, sequence])
  @@index([installmentPlanId])
  @@index([dueDate])
}

enum InstallmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtDirection {
  OWED_TO_YOU
  YOU_OWE
}

model Debt {
  id           String        @id @default(cuid())
  userId       String
  direction    DebtDirection
  counterparty String
  principal    Decimal       @db.Decimal(18, 4)
  currency     String        @default("USD")
  openedAt     DateTime
  dueAt        DateTime?
  interestApr  Decimal?      @db.Decimal(8, 4)
  notes        String?
  settledAt         DateTime?
  totalInstallments Int                  @default(1)
  paidInstallments  Int                  @default(0)
  installmentAmount Decimal?             @db.Decimal(18, 4)
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([openedAt])
  @@index([dueAt])
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  targetAmount Decimal   @db.Decimal(18, 4)
  currency     String    @default("USD")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries SavingsEntry[]

  @@index([userId])
  @@index([deadline])
}

model SavingsEntry {
  id            String   @id @default(cuid())
  userId        String
  savingsGoalId String?
  amount        Decimal  @db.Decimal(18, 4)
  currency      String   @default("USD")
  contributedAt DateTime
  note          String?
  createdAt     DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([savingsGoalId])
  @@index([contributedAt])
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Recurring expense (subscriptions, rent, periodic payments to people).
/// The next due date is computed from `anchorDate` + frequency × interval.
model RecurringExpense {
  id            String              @id @default(cuid())
  userId        String
  label         String
  amount        Decimal             @db.Decimal(18, 4)
  currency      String              @default("USD")
  category      String?
  frequency     RecurrenceFrequency
  /// Every N periods (1 = every week/month/year).
  interval      Int                 @default(1)
  /// First occurrence; later due dates step forward from here.
  anchorDate    DateTime
  bankAccountId String?
  active        Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankAccountId])
  @@index([active])
}

enum InvestmentKind {
  ETF
  REMUNERATED_ACCOUNT
}

model Investment {
  id            String         @id @default(cuid())
  userId        String
  kind          InvestmentKind
  label         String
  currency      String         @default("USD")
  /// ETF: ticker symbol (e.g. VTI). Ignored for remunerated accounts.
  symbol        String?
  shares        Decimal?       @db.Decimal(24, 8)
  /// Remunerated / interest-bearing: nominal annual rate (e.g. 0.05 for 5%).
  annualRate    Decimal?       @db.Decimal(8, 6)
  principal     Decimal?       @db.Decimal(18, 4)
  bankAccountId String?
  openedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kind])
  @@index([symbol])
  @@index([bankAccountId])
}

/// Alpha Vantage quote cache.
/// TTL (~24h): application treats rows with fetchedAt older than 24 hours as stale,
/// refetches from the API, then upserts by symbol.
model EtfPriceCache {
  id        String   @id @default(cuid())
  symbol    String   @unique
  fetchedAt DateTime
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal? @db.Decimal(24, 4)
  rawJson   Json?

  @@index([fetchedAt])
}
