// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  bankAccounts      BankAccount[]
  transactions      Transaction[]
  installmentPlans  InstallmentPlan[]
  debts             Debt[]
  savingsGoals      SavingsGoal[]
  savingsEntries    SavingsEntry[]
  investments       Investment[]
  recurringExpenses RecurringExpense[]
  walletItems       WalletItemDashboard[]

  @@map("user")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING // Corriente
  SIGHT // Vista / Cuenta RUT
  SAVINGS // Ahorro
  INVESTMENT // Inversiones (Fintual)
  CREDIT_LINE // Línea de crédito (tarjeta de crédito sin cuenta bancaria / retail)
  CASH // Efectivo
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

/// Physical payment instruments (the "plastic"). Prepaid included.
enum CardKind {
  CREDIT
  DEBIT
  PREPAID
}

model BankAccount {
  id                String        @id @default(cuid())
  userId            String
  name              String
  type              AccountType   @default(CHECKING)
  status            AccountStatus @default(ACTIVE)
  currency          String        @default("CLP")
  /// Free-text institution name (mirrors the selected bank's name; kept for display / manual entry).
  institution       String?
  /// Optional link to a registered FinancialInstitution (the "institution" selector). Null for cash/manual.
  institutionId     String?
  /// Bank account number (free text, stored/displayed in full — NOT a card PAN).
  accountNumber     String?
  /// User-set seed balance (own funds). For CREDIT_LINE accounts typically 0.
  initialBalance    Decimal       @default(0) @db.Decimal(18, 4)
  /// Reconciled/cached balance = initialBalance + Σincome − Σexpense.
  currentBalance    Decimal       @default(0) @db.Decimal(18, 4)
  /// Credit pool for CREDIT_LINE accounts (shared by all its cards). 0 otherwise.
  creditLimit       Decimal       @default(0) @db.Decimal(18, 4)
  /// Seed of already-used credit at creation. Reconciled used = creditUsedInitial + Σexpense − Σincome.
  creditUsedInitial Decimal       @default(0) @db.Decimal(18, 4)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialInstitution FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  investments       Investment[]
  cards             CardAccount[]
  recurringExpenses RecurringExpense[]
  walletItems       WalletItemDashboard[]

  @@index([userId])
  @@index([status])
  @@index([institutionId])
  @@map("bank-account")
}

model CardAccount {
  id          String   @id @default(cuid())
  accountId   String
  userId      String
  name        String
  kind        CardKind
  /// Only the last 4 digits are ever stored. Full PAN never transmitted/persisted.
  last4       String
  expiryMonth Int
  expiryYear  Int
  /// Whether the card is active (blocked/expired cards can be marked inactive).
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account      BankAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  walletItems  WalletItemDashboard[]
  transactions Transaction[]

  @@index([accountId])
  @@index([userId])
  @@map("card-account")
}

/// User-curated "wallet" on the dashboard. Each item pins EITHER a card or an
/// account (exactly one of cardId/accountId; enforced in the service). `order`
/// is the manual drag-and-drop position.
model WalletItemDashboard {
  id        String   @id @default(cuid())
  userId    String
  accountId String?
  cardId    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BankAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card    CardAccount? @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@unique([userId, cardId])
  @@index([userId])
  @@map("wallet-item-dashboard")
}

model Transaction {
  id                String          @id @default(cuid())
  userId            String
  bankAccountId     String?
  cardId            String?
  type              TransactionType
  amount            Decimal         @db.Decimal(18, 4)
  currency          String          @default("USD")
  occurredAt        DateTime
  category          String?
  description       String?
  observation       String?
  emisor            String?
  receptor          String?
  lugar             String?
  installmentPlanId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  card            CardAccount?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankAccountId])
  @@index([cardId])
  @@index([occurredAt])
  @@index([installmentPlanId])
  @@index([category])
  @@map("transaction")
}

model InstallmentPlan {
  id                String               @id @default(cuid())
  userId            String
  title             String
  totalPrincipal    Decimal              @db.Decimal(18, 4)
  installmentCount  Int
  startDate         DateTime
  currency          String               @default("USD")
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     InstallmentPayment[]
  transactions Transaction[]

  @@index([userId])
  @@index([startDate])
  @@map("installment-plan")
}

model InstallmentPayment {
  id                String    @id @default(cuid())
  installmentPlanId String
  sequence          Int
  dueDate           DateTime
  amount            Decimal   @db.Decimal(18, 4)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@unique([installmentPlanId, sequence])
  @@index([installmentPlanId])
  @@index([dueDate])
  @@map("installment-payment")
}

enum InstallmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtDirection {
  OWED_TO_YOU
  YOU_OWE
}

model Debt {
  id                String               @id @default(cuid())
  userId            String
  direction         DebtDirection
  counterparty      String
  principal         Decimal              @db.Decimal(18, 4)
  currency          String               @default("USD")
  openedAt          DateTime
  dueAt             DateTime?
  interestApr       Decimal?             @db.Decimal(8, 4)
  notes             String?
  settledAt         DateTime?
  totalInstallments Int                  @default(1)
  paidInstallments  Int                  @default(0)
  installmentAmount Decimal?             @db.Decimal(18, 4)
  frequency         InstallmentFrequency @default(MONTHLY)
  frequencyInterval Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([openedAt])
  @@index([dueAt])
  @@map("debt")
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  targetAmount Decimal   @db.Decimal(18, 4)
  currency     String    @default("USD")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries SavingsEntry[]

  @@index([userId])
  @@index([deadline])
  @@map("savings-goal")
}

model SavingsEntry {
  id            String   @id @default(cuid())
  userId        String
  savingsGoalId String?
  amount        Decimal  @db.Decimal(18, 4)
  currency      String   @default("USD")
  contributedAt DateTime
  note          String?
  createdAt     DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([savingsGoalId])
  @@index([contributedAt])
  @@map("savings-entry")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Recurring expense (subscriptions, rent, periodic payments to people).
/// The next due date is computed from `anchorDate` + frequency × interval.
model RecurringExpense {
  id            String              @id @default(cuid())
  userId        String
  label         String
  amount        Decimal             @db.Decimal(18, 4)
  currency      String              @default("USD")
  category      String?
  frequency     RecurrenceFrequency
  /// Every N periods (1 = every week/month/year).
  interval      Int                 @default(1)
  /// First occurrence; later due dates step forward from here.
  anchorDate    DateTime
  bankAccountId String?
  active        Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankAccountId])
  @@index([active])
  @@map("recurring-expense")
}

enum InvestmentKind {
  ETF
  REMUNERATED_ACCOUNT
}

model Investment {
  id            String         @id @default(cuid())
  userId        String
  kind          InvestmentKind
  label         String
  currency      String         @default("USD")
  /// ETF: ticker symbol (e.g. VTI). Ignored for remunerated accounts.
  symbol        String?
  shares        Decimal?       @db.Decimal(24, 8)
  /// Remunerated / interest-bearing: nominal annual rate (e.g. 0.05 for 5%).
  annualRate    Decimal?       @db.Decimal(8, 6)
  principal     Decimal?       @db.Decimal(18, 4)
  bankAccountId String?
  openedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kind])
  @@index([symbol])
  @@index([bankAccountId])
  @@map("investment")
}

/// Alpha Vantage quote cache.
/// TTL (~24h): application treats rows with fetchedAt older than 24 hours as stale,
/// refetches from the API, then upserts by symbol.
model EtfPriceCache {
  id        String   @id @default(cuid())
  symbol    String   @unique
  fetchedAt DateTime
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal? @db.Decimal(24, 4)
  rawJson   Json?

  @@index([fetchedAt])
  @@map("etf-price-cache")
}

// --- Reference data: countries + banks ---

enum BankCategory {
  ESTABLISHED    // Bancos establecidos en el país
  FOREIGN_BRANCH // Sucursales de bancos extranjeros
  STATE          // Bancos estatales
}

/// ISO 3166-1 country reference. Banks (and future entities) link here.
model Country {
  id      String @id @default(cuid())
  /// ISO 3166-1 alpha-2 (e.g. "CL"). Canonical code used for lookups/auditing.
  alpha2  String @unique
  /// ISO 3166-1 alpha-3 (e.g. "CHL").
  alpha3  String @unique
  /// ISO 3166-1 numeric (e.g. "152").
  numeric String @unique
  name    String

  institutions FinancialInstitution[]
  currencies   CountryCurrency[]

  @@map("country")
}

/// ISO 4217 currency reference (deduplicated by alpha code). `currency` string
/// fields across the app use these codes (CLP, USD, EUR…).
model Currency {
  id      String @id @default(cuid())
  /// ISO 4217 alpha code (e.g. "CLP").
  code    String @unique
  /// ISO 4217 numeric code (e.g. "152").
  numeric String
  /// Currency name (e.g. "Peso chileno").
  name    String

  countries CountryCurrency[]

  @@map("currency")
}

/// Which currencies a country uses (a country may have several; a currency is
/// shared by many countries). `isPrimary` marks the main one.
model CountryCurrency {
  id         String  @id @default(cuid())
  countryId  String
  currencyId String
  isPrimary  Boolean @default(false)

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([countryId, currencyId])
  @@index([currencyId])
  @@map("country-currency")
}

enum InstitutionKind {
  BANK // Banco establecido / estatal / sucursal extranjera
  NON_BANK_ISSUER // Emisor de tarjetas de pago con provisión de fondos no bancario
}

/// Financial-institution registry: banks + non-bank card issuers. Scoped to a country.
/// (Chile: código SBIF/CMF for banks, código institucional for non-bank issuers.)
model FinancialInstitution {
  id        String          @id @default(cuid())
  countryId String
  kind      InstitutionKind @default(BANK)
  /// Institutional/regulator code (SBIF/CMF for banks; código institucional for issuers).
  code      String
  name      String
  /// Chilean tax id (RUT) — mainly for non-bank issuers; null otherwise.
  rut       String?
  /// Bank sub-category; null for non-bank issuers.
  category  BankCategory?
  /// Other commercial brands the institution operates under.
  brands    String[]        @default([])
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  country  Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  accounts BankAccount[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([kind])
  @@map("financial-institution")
}
