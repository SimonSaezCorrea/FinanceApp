# Backend API environment
DATABASE_URL="postgresql://user:password@localhost:5432/financeApp"
PORT=3001
# Every origin allowed to call the API with credentials, comma-separated: the public site
# (apps/landing) and the app (apps/web). Production: "https://cuadra.cl,https://app.cuadra.cl".
CORS_ORIGIN="http://localhost:4321,http://localhost:5173"

# Auth (JWT in httpOnly cookies)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
# Token lifetimes — units: s (seconds), m (minutes), h (hours), d (days)
# Access token is short-lived; the frontend auto-refreshes it silently.
# Refresh token controls how long a session lasts without any activity.
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Pagination cursor signing (HMAC over the keyset cursor; required at boot, same as the JWT secrets)
CURSOR_SIGNING_SECRET="change-me-cursor"

# MFA (TOTP). MFA_ENCRYPTION_KEY: 32-byte hex key (e.g. `openssl rand -hex 32`) used to
# AES-256-GCM the TOTP secret at rest. MFA_PENDING_TOKEN_SECRET: signs the short-lived
# (5min) "second factor pending" cookie issued between password login and the MFA code —
# deliberately a DIFFERENT secret from JWT_ACCESS_SECRET so a pending token can never be
# mistaken for a real session token. Both required at boot, same as the JWT secrets.
MFA_ENCRYPTION_KEY="change-me-32-byte-hex-0000000000000000000000000000000000000000"
MFA_PENDING_TOKEN_SECRET="change-me-mfa-pending"

# Passkeys (WebAuthn). Signs the short-lived (5min) challenge cookie issued between requesting
# registration/login options and verifying the browser's response — same mechanism as
# MFA_PENDING_TOKEN_SECRET, its own separate secret. Every CORS_ORIGIN is an accepted passkey origin;
# the rpId is PASSKEY_RP_ID (optional, default: the first origin's hostname). Production sets it to
# the parent domain ("cuadra.cl") so one passkey works on the public site and in the app; every
# origin must be that host or a subdomain of it, or the API refuses to start.
# PASSKEY_RP_ID="cuadra.cl"
PASSKEY_CHALLENGE_SECRET="change-me-passkey-challenge"


# Object storage for movement attachments (S3-compatible: AWS S3, MinIO, R2, Backblaze).
# All optional: with no bucket/credentials the attachment endpoints answer 503
# ATTACHMENTS_UNAVAILABLE and the rest of the app is unaffected.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Sessions (specs/023). Optional path to a GeoLite2-Country .mmdb file (your own MaxMind
# account) for resolving a session's approximate country from its login IP. Unset, or an
# unreadable/missing file, means sessions still work — just without a country shown, the
# same "inert without config" behavior S3 has above for attachments.
# Superseded as the preferred source by IPINFO_TOKEN below (specs/026) when both are set —
# the two are never combined, IPinfo wins outright for that lookup.
GEOIP_DB_PATH=

# IP geolocation via IPinfo (specs/026), preferred over GEOIP_DB_PATH above when both are set.
# Optional — inert without it (falls back to GEOIP_DB_PATH, or no country at all). Free/unlimited
# "Lite" tier at https://ipinfo.io/signup — country + ASN only, no city. Its data is CC BY-SA 4.0:
# the app shows a visible attribution in Profile → Security as the license requires. Results are
# cached internally for 60 days (table ip-geolocation-cache) so a repeat IP costs zero API calls.
IPINFO_TOKEN=

# Shared HMAC key for hashing an identifier (RUT/DNI) instead of storing it in the clear —
# used by the account-deletion audit log (`AccountDeletionLog.identifierHash`) and a minor's
# guardian authorization (`ConsentRecord.guardianIdentifierHash`). Required, same as the other
# secrets above.
IDENTIFIER_HASH_SECRET="change-me-identifier-hash"

# Dev only — simulated network latency (ignored when NODE_ENV=production).
# 0 or unset = off. Makes localhost behave like prod so the web app's loading /
# skeleton states are actually reachable while developing.
API_DELAY_MS=800
API_DELAY_JITTER_MS=400

# Exchange rates (specs/030): daily dolar observado and UF, recorded from mindicador.cl.
# Optional: the default is https://mindicador.cl/api. Point it elsewhere only for tests/staging.
# EXCHANGE_RATE_SOURCE_URL=https://mindicador.cl/api
