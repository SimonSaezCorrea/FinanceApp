{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", "src", "test", "scripts", "functions", "*.config.*"],
  "exclude": ["dist"]
}
