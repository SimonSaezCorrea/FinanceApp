---
import "@fontsource-variable/geist";
import "@fontsource-variable/inter";
import "@finance/ui/src/styles/brand-font.css";
import "../styles/global.css";

import { PRE_PAINT_SCRIPT } from "@finance/ui/prepaint.mjs";
// The body font, requested right away instead of after the stylesheet is parsed (Lighthouse's
// "network dependency tree"). Same hashed file the @font-face points at, so it's fetched once.
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { brandHtml } from "@finance/ui/src/shared/lib/brand";

// Development only: the access panel is React loaded on demand, and @vitejs/plugin-react's Fast
// Refresh refuses to run a component module unless the page installed its preamble — which Astro
// only does on pages with hydrated islands, and these have none. Without it the panel never opens
// under `astro dev` (production builds carry no Fast Refresh code).
const REACT_REFRESH_PREAMBLE = `import RefreshRuntime from "/@react-refresh";
RefreshRuntime.injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;
window.__vite_plugin_react_preamble_installed__ = true;`;

import Footer from "../domains/landing/components/Footer.astro";
import Header from "../domains/landing/components/Header.astro";
import MobileMenu from "../domains/landing/components/MobileMenu.astro";
import { t } from "../i18n";
import { LANGUAGES, type Language, type Page, pagePath } from "../lib/language";
import { BRAND_PROFILES, CONTACT_EMAIL, FOUNDER } from "../lib/organization";

/**
 * Every public page (spec 031, contracts/page-metadata.md): its own title, description, canonical,
 * language alternates (plus x-default = the root that picks one) and social preview, the theme
 * applied before the first paint, the header/menu/footer, and an empty `#access-root` where the
 * access panel mounts once someone opens it.
 */
interface Props {
  lang: Language;
  page: Page;
  /** The 404 page: its own title, no canonical or alternates, never indexed. */
  notFound?: boolean;
  /** A page an email link opens (specs/032): its own title, never indexed, out of the sitemap. */
  utility?: "verifyEmail" | "resetPassword";
  /** Title/description built by the page itself (spec 033: they carry the value of the day). */
  title?: string;
  description?: string;
  /** The page's own address per language when it is not `pagePath(lang, page)` (spec 035: a guide
   * and its pair, whose slugs differ; a language missing here has no version of the page). */
  paths?: Partial<Record<Language, string>>;
}
const { lang, page, notFound = false, utility, paths } = Astro.props;
const unindexed = notFound || utility !== undefined;
const site = (Astro.site?.toString() ?? "http://localhost:4321/").replace(/\/+$/, "");
const url = (l: Language) => `${site}${paths?.[l] ?? pagePath(l, page)}`;
// Alternates only for the languages the page exists in (a guide written in one language has none).
const alternates = paths ? LANGUAGES.filter((l) => paths[l] !== undefined) : LANGUAGES;
const metaKey = utility ?? page;
const title =
  Astro.props.title ??
  (notFound
    ? `${t(lang, "app.notFound.title")} · fik`
    : t(lang, `landing.meta.${metaKey}.title`));
const description = Astro.props.description ?? t(lang, `landing.meta.${metaKey}.description`);
const image = `${site}/og/fik-${lang}.png`;
// Visit statistics (Cloudflare Web Analytics: aggregated, no cookies), declared in the privacy
// policy. Added here by hand instead of Cloudflare's automatic injection so it runs ONLY on the
// public pages: never on the pages an email link opens (their address carries a one-time token
// the beacon would send along with the URL), never on the 404, never in the app.
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN?.trim();
const analytics = analyticsToken && !unindexed ? JSON.stringify({ token: analyticsToken }) : null;
// Structured data on the home page (both languages): tells Google the site is called "fik"
// (also searched as "mifik") so brand searches show that name and lead here.
const structuredData =
  page === "home" && !unindexed
    ? JSON.stringify([
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: "fik",
          alternateName: ["mifik", "mifik.cl"],
          url: `${site}/`,
          inLanguage: lang === "es" ? "es-CL" : "en-US",
        },
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          name: "fik",
          alternateName: "mifik",
          url: `${site}/`,
          email: CONTACT_EMAIL,
          slogan: t(lang, "brand.slogan"),
          // A raster square: search engines don't take the SVG favicon as a logo.
          logo: `${site}/logo.png`,
          sameAs: BRAND_PROFILES,
          // Everyone writes to the same address; no phone on purpose (it would be a personal one).
          contactPoint: {
            "@type": "ContactPoint",
            email: CONTACT_EMAIL,
            contactType: "customer support",
            areaServed: "CL",
            availableLanguage: ["es", "en"],
          },
          founder: {
            "@type": "Person",
            name: FOUNDER.name,
            url: `${site}${pagePath(lang, "about")}#author`,
            sameAs: FOUNDER.profiles,
          },
        },
      ])
    : null;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#0b1518" />
    <script is:inline set:html={PRE_PAINT_SCRIPT} />
    {import.meta.env.DEV && <script type="module" is:inline set:html={REACT_REFRESH_PREAMBLE} />}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* An email link carries a one-time token in the address: never pass it on (specs/032). */}
    {utility && <meta name="referrer" content="no-referrer" />}
    {
      unindexed ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={url(lang)} />
          {alternates.map((l) => (
            <link rel="alternate" hreflang={l} href={url(l)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={`${site}/`} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fik" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(lang, "landing.meta.imageAlt")} />
    <meta property="og:locale" content={lang === "es" ? "es_CL" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <slot name="head" />
    {
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={analytics}
        />
      )
    }
  </head>
  <body>
    <div class="min-h-dvh overflow-x-clip bg-background text-foreground">
      <a
        href="#landing-main"
        class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-background"
      >
        {t(lang, "landing.skipToContent")}
      </a>
      <Header lang={lang} page={page} paths={paths} />
      <MobileMenu lang={lang} page={page} paths={paths} />
      <main id="landing-main" tabindex="-1" class="mx-auto max-w-[1240px] px-4 focus:outline-none">
        <slot />
        <Footer lang={lang} />
      </main>
      <div id="access-root" data-lang={lang}></div>
      {/* "Ir a la app" found the app down: right under the header, by the button that was just
          pressed, and it stays until closed or retried (a self-hiding toast went unseen). */}
      <div
        data-app-down
        role="alert"
        hidden
        class="fixed inset-x-4 top-[calc(var(--landing-header,64px)+0.75rem)] z-50 mx-auto flex max-w-[1240px] justify-end sm:px-4"
      >
        <div class="flex w-full max-w-sm gap-3 rounded-xl border border-warning/50 bg-card p-4 shadow-xl ring-1 ring-warning/20">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="mt-0.5 size-5 shrink-0 text-warning"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
          </svg>
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <p class="text-sm font-semibold text-foreground">
              {t(lang, "landing.nav.appUnavailableTitle")}
            </p>
            <p
              class="text-sm text-muted-foreground"
              set:html={brandHtml(t(lang, "landing.nav.appUnavailable"))}
            />
            <div class="mt-2 flex gap-2">
              <button
                type="button"
                data-app-down-retry
                class="rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground hover:bg-primary/90"
              >
                {t(lang, "landing.nav.appUnavailableRetry")}
              </button>
            </div>
          </div>
          <button
            type="button"
            data-app-down-close
            aria-label={t(lang, "landing.nav.appUnavailableClose")}
            class="-m-1 grid size-8 shrink-0 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
    <script>
      import "../domains/landing/scripts/header";
      import { initAccess } from "../domains/landing/scripts/access";
      import { initGoToApp, initSession } from "../domains/landing/scripts/session";

      initAccess();
      initGoToApp();
      void initSession();
    </script>
  </body>
</html>
