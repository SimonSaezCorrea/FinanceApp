---
/**
 * A page that only sends the visitor on (spec 031, contracts/routes.md): the script keeps the
 * query (`?acceso=…&volver=…`) and the anchor (`#faq-minors`), which a meta refresh would drop;
 * the meta refresh covers a visitor without JavaScript; the canonical tells a crawler where the
 * content lives. In production these pages are never served: Cloudflare Pages answers first with
 * real redirects (`public/_redirects` = 301 for the old addresses). They stay as the fallback where
 * no host rules run (`astro preview`).
 */
interface Props {
  /** Where to go. */
  target: string;
}
const { target } = Astro.props;
const site = (Astro.site?.toString() ?? "http://localhost:4321/").replace(/\/+$/, "");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>mifik</title>
    <link rel="canonical" href={`${site}${target}`} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <p><a href={target}><i>mifik</i></a></p>
  </body>
</html>
