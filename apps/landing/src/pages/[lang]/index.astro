---
import HomeView from "../../domains/landing/components/HomeView.astro";
import { DEFAULT_LANGUAGE, type Language, LANGUAGES } from "../../lib/language";

// Every language but Spanish, whose home is the root (src/pages/index.astro).
export function getStaticPaths() {
  return LANGUAGES.filter((lang) => lang !== DEFAULT_LANGUAGE).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Language;
---

<HomeView lang={lang} />
