---
import { simulateInstallments } from "@finance/money/installment-simulation";

import { LandingPage } from "../../domains/landing/pages/LandingPage";
import { islandJson, ratesIsland } from "../../domains/rates/lib/island";
import { DEFAULT_INPUT } from "../../domains/simulator/lib/defaults";
import { formatAmount, formatPercent } from "../../domains/simulator/lib/format";
import PageLayout from "../../layouts/PageLayout.astro";
import { buildRatesSnapshot } from "../../lib/exchangeRates";
import { type Language, LANGUAGES, pagePath } from "../../lib/language";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
// The "UF y dólar hoy" block (spec 033, FR-013): values of the build, refreshed on arrival.
const snapshot = await buildRatesSnapshot();
const island = ratesIsland(lang, snapshot);
// The home only needs the newest rows (and the one before, never shown): keep the island small.
island.rows = snapshot ? [snapshot.latest.USD, snapshot.latest.CLF].filter((r) => r !== null) : [];
const homeRates = {
  lang,
  latest: snapshot?.latest ?? { USD: null, CLF: null },
  links: { CLF: pagePath(lang, "ufValue"), USD: pagePath(lang, "dollarRate") },
};
// The simulator block (spec 034, FR-017): the page's example, solved at build like the page itself.
const example = simulateInstallments(DEFAULT_INPUT);
const homeSimulator = {
  link: pagePath(lang, "installmentSimulator"),
  example: {
    price: formatAmount(DEFAULT_INPUT.price, DEFAULT_INPUT.currency, lang),
    count: DEFAULT_INPUT.installments!,
    rate: formatPercent(DEFAULT_INPUT.monthlyRatePercent, lang, 0).replace(/\s?%$/, ""),
    payment: formatAmount(example.regularPayment, DEFAULT_INPUT.currency, lang),
  },
};
---

<PageLayout lang={lang} page="home">
  <LandingPage lang={lang} page="home" homeRates={homeRates} homeSimulator={homeSimulator} />
  <script type="application/json" id="rates-data" set:html={islandJson(island)} />
</PageLayout>

<script>
  import { initRatesHome } from "../../domains/rates/scripts/rates";

  initRatesHome();
</script>
