---
import { versionCatalog } from "@finance/release-notes";
import { brandHtml } from "@finance/ui/src/shared/lib/brand";

import { HERO_TITLE } from "../../../domains/landing/components/bits";
import ReleaseVersionPage from "../../../domains/releases/components/ReleaseVersionPage.astro";
import { t } from "../../../i18n";
import PageLayout from "../../../layouts/PageLayout.astro";
import { type Language, LANGUAGES, LOCALIZED_SLUGS } from "../../../lib/language";

/**
 * Novedades (spec 038): the newest version. Older ones are `[version].astro`. The records live in
 * `packages/release-notes/releases/` (the same ones the app shows) and their versions come from
 * the deploy's git tags; a broken record stops the build naming its file.
 */
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang, releaseNotes: LOCALIZED_SLUGS.releaseNotes[lang] },
  }));
}

const lang = Astro.params.lang as Language;
const versions = versionCatalog();
---

{
  versions.length > 0 ? (
    <ReleaseVersionPage lang={lang} version={versions[0]!} versions={versions} />
  ) : (
    <PageLayout lang={lang} page="releaseNotes">
      <section aria-labelledby="release-notes-title" class="flex flex-col gap-3 py-10 lg:py-16">
        <h1 id="release-notes-title" tabindex="-1" class={HERO_TITLE}>
          {t(lang, "landing.releaseNotes.title")}
        </h1>
        <p class="text-lg text-muted-foreground" set:html={brandHtml(t(lang, "landing.releaseNotes.lead"))} />
        <p class="text-muted-foreground">{t(lang, "landing.releaseNotes.empty")}</p>
      </section>
    </PageLayout>
  )
}
