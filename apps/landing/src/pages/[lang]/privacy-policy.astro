---
import { HERO_TITLE } from "../../domains/landing/components/bits";
import PageLayout from "../../layouts/PageLayout.astro";
import { t } from "../../i18n";
import { type Language, LANGUAGES } from "../../lib/language";
import { Content as En } from "../../legal/privacy-policy.en.md";
import { Content as Es } from "../../legal/privacy-policy.es.md";

/**
 * The legal privacy policy (Ley 21.719, deber de información). The text lives in
 * `src/legal/privacy-policy.<lang>.md`: Spanish is the version that applies, English a translation
 * that says so. Linked from the footer, the plain-language Privacy page and the sign-up consent.
 * Internal compliance notes stay in `.compliance/docs/21719-politica-privacidad.md`.
 */
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const Body = lang === "es" ? Es : En;
---

<PageLayout lang={lang} page="privacyPolicy">
  <article class="prose-fik mx-auto flex max-w-[46rem] flex-col gap-6 pb-16 pt-8 sm:pt-10 lg:pt-16">
    <h1 id="landing-privacy-policy-title" tabindex="-1" class={HERO_TITLE}>
      {t(lang, "landing.privacyPolicy.title")}
    </h1>
    <Body />
  </article>
</PageLayout>
