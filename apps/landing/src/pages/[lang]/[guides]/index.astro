---
import { HERO_TITLE } from "../../../domains/landing/components/bits";
import { formatDay } from "../../../domains/rates/lib/chileDay";
import { isoDay } from "../../../domains/guides/lib/dates";
import { sortForIndex } from "../../../domains/guides/lib/guides";
import { loadGuides } from "../../../domains/guides/lib/load";
import { t } from "../../../i18n";
import PageLayout from "../../../layouts/PageLayout.astro";
import { type Language, LANGUAGES, LOCALIZED_SLUGS, pagePath } from "../../../lib/language";

/** The guides of one language (spec 035, FR-012): `/es/guias/`, `/en/guides/`, newest review first. */
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang, guides: LOCALIZED_SLUGS.guides[lang] } }));
}

const lang = Astro.params.lang as Language;
const { guides } = await loadGuides();
const list = sortForIndex(guides, lang);

const site = (Astro.site?.toString() ?? "http://localhost:4321/").replace(/\/+$/, "");
const url = `${site}${pagePath(lang, "guides")}`;
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: t(lang, "landing.guides.title"),
    url,
    inLanguage: lang === "es" ? "es-CL" : "en-US",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: list.map((g, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site}${g.path}`,
        name: g.title,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "fik", item: `${site}${pagePath(lang, "home")}` },
      { "@type": "ListItem", position: 2, name: t(lang, "landing.guides.breadcrumb"), item: url },
    ],
  },
]).replace(/</g, "\\u003c");
---

<PageLayout lang={lang} page="guides">
  <script slot="head" type="application/ld+json" set:html={structuredData} />

  <section aria-labelledby="guides-title" class="flex flex-col gap-8 py-10 lg:py-16">
    <div class="flex max-w-[60ch] flex-col gap-3">
      <h1 id="guides-title" tabindex="-1" class={HERO_TITLE}>{t(lang, "landing.guides.title")}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{t(lang, "landing.guides.lead")}</p>
    </div>

    {
      list.length === 0 ? (
        <p class="text-muted-foreground">{t(lang, "landing.guides.empty")}</p>
      ) : (
        <ul class="grid gap-4 md:grid-cols-2">
          {list.map((g) => (
            <li>
              <a
                href={g.path}
                class="flex h-full flex-col gap-2 rounded-2xl border bg-card p-5 transition-colors hover:border-primary/50 sm:p-6"
              >
                <span class="text-lg font-semibold tracking-tight">{g.title}</span>
                <span class="text-sm leading-relaxed text-muted-foreground">{g.description}</span>
                <time datetime={isoDay(g.reviewedAt)} class="mt-auto pt-2 text-xs text-muted-foreground">
                  {t(lang, "landing.guides.reviewedShort", { date: formatDay(isoDay(g.reviewedAt), lang) })}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</PageLayout>
