---
import { buttonClasses } from "@finance/ui/src/shared/ui/button-classes";

import PageLayout from "../../layouts/PageLayout.astro";
import { t } from "../../i18n";
import { type Language, LANGUAGES, pagePath } from "../../lib/language";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const k = (key: string) => t(lang, `landing.resetPassword.${key}`);
const signIn = `${pagePath(lang, "home")}?acceso=login`;
const field =
  "h-11 w-full rounded-md border border-input bg-background px-3 text-base text-foreground sm:text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
---

<PageLayout lang={lang} page="home" utility="resetPassword">
  <section class="mx-auto flex max-w-[28rem] flex-col gap-4 py-20">
    <h1 class="text-center text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
      {k("title")}
    </h1>

    <div data-state="form" hidden>
      <p class="mb-6 text-center text-base text-muted-foreground">{k("description")}</p>
      <form data-reset-form class="flex flex-col gap-4" novalidate>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          {k("password")}
          <input
            class={field}
            type="password"
            name="password"
            autocomplete="new-password"
            minlength="8"
            required
          />
          <span class="text-xs font-normal text-muted-foreground">{k("hint")}</span>
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          {k("confirmation")}
          <input
            class={field}
            type="password"
            name="confirmation"
            autocomplete="new-password"
            required
          />
        </label>
        <p
          data-problem
          role="alert"
          hidden
          class="text-sm text-destructive"
          data-too-short={k("tooShort")}
          data-mismatch={k("mismatch")}
          data-error={k("error")}
        >
        </p>
        <button type="submit" class={buttonClasses({ variant: "primary" })}>{k("submit")}</button>
      </form>
    </div>

    <div data-state="success" hidden aria-live="polite" class="flex flex-col items-center gap-6 text-center">
      <p class="text-base text-muted-foreground">{k("success")}</p>
      <a href={signIn} data-access="login" class={buttonClasses({ variant: "primary" })}>
        {k("signIn")}
      </a>
    </div>
    <div data-state="invalid" hidden aria-live="polite" class="flex flex-col items-center gap-6 text-center">
      <p class="text-base text-muted-foreground">{k("invalid")}</p>
      <a href={signIn} data-access="login" class={buttonClasses({ variant: "outline" })}>
        {k("again")}
      </a>
    </div>
  </section>
</PageLayout>

<script>
  import { initResetPassword } from "../../domains/auth/scripts/reset-password";

  initResetPassword();
</script>
