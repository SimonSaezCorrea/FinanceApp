---
import { t } from "../../../i18n";
import { type Language, pagePath } from "../../../lib/language";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const LINKS = [
  { page: "privacy", key: "landing.nav.privacy" },
  { page: "privacyPolicy", key: "landing.nav.privacyPolicy" },
  { page: "pricing", key: "landing.nav.pricing" },
  { page: "faq", key: "landing.nav.faq" },
] as const;
---

<!-- `relative z-10 bg-background`: slides over the FAQ's fixed column at the end of that page. -->
<footer
  class="relative z-10 flex flex-wrap items-center gap-x-6 gap-y-2 border-t bg-background py-8 text-xs text-muted-foreground"
>
  <p class="flex flex-col gap-1">
    <span class="text-sm font-medium text-foreground">{t(lang, "brand.slogan")}</span>
    <span>{t(lang, "landing.footer.tagline")}</span>
  </p>
  <nav aria-label={t(lang, "landing.footer.nav")} class="flex flex-wrap gap-x-5 gap-y-1 sm:ml-auto">
    {
      LINKS.map((item) => (
        <a
          href={pagePath(lang, item.page)}
          class="inline-flex min-h-11 items-center transition-colors hover:text-foreground sm:min-h-0"
        >
          {t(lang, item.key)}
        </a>
      ))
    }
  </nav>
</footer>
