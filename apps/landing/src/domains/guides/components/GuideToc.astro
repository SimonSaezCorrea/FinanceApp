---
import type { MarkdownHeading } from "astro";

import { t } from "../../../i18n";
import type { Language } from "../../../lib/language";

/**
 * "En esta guía" (spec 035, FR-005): one link per section (`h2`) of the guide's own text. A closed
 * native `<details>` above the body: one line tall, so the answer stays above the fold on a phone
 * (SC-001), and it opens without any script.
 */
interface Props {
  lang: Language;
  headings: MarkdownHeading[];
}
const { lang, headings } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
---

{
  sections.length > 0 && (
    <nav aria-label={t(lang, "landing.guides.toc")}>
      <details class="group rounded-xl border bg-card">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 text-sm font-medium [&::-webkit-details-marker]:hidden">
          {t(lang, "landing.guides.toc")}
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ol class="flex list-decimal flex-col gap-1.5 border-t px-4 py-3 pl-9 text-sm">
          {sections.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-primary underline-offset-4 hover:underline">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
