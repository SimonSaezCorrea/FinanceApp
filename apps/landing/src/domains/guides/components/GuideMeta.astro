---
import { brandHtml } from "@finance/ui/src/shared/lib/brand";
import { t } from "../../../i18n";
import { type Language, pagePath } from "../../../lib/language";
import { formatDay } from "../../rates/lib/chileDay";
import { isoDay } from "../lib/dates";

/** Published · reviewed · author (spec 035, FR-007), both dates always shown (the review date is
 * what tells a reader the sources were checked), as `<time>` for crawlers. The author's name links
 * to their presentation on the About page; "Cómo escribimos" to the editorial policy. */
interface Props {
  lang: Language;
  publishedAt: Date;
  reviewedAt: Date;
  author: string;
}
const { lang, publishedAt, reviewedAt, author } = Astro.props;
const published = isoDay(publishedAt);
const reviewed = isoDay(reviewedAt);
const role = brandHtml(t(lang, "landing.guides.authorRole"));
---

<p class="flex flex-wrap gap-x-2 gap-y-1 text-sm text-muted-foreground">
  <time datetime={published}>{t(lang, "landing.guides.published", { date: formatDay(published, lang) })}</time>
  <span aria-hidden="true">·</span>
  <time datetime={reviewed}>{t(lang, "landing.guides.reviewed", { date: formatDay(reviewed, lang) })}</time>
  <span aria-hidden="true">·</span>
  <span data-guide-author>
    <a href={`${pagePath(lang, "about")}#author`} class="font-medium text-foreground underline-offset-4 hover:underline">{author}</a
    >{", "}<span set:html={role} />
  </span>
  <span aria-hidden="true">·</span>
  <a
    data-guide-editorial
    href={pagePath(lang, "editorial")}
    class="underline-offset-4 hover:text-foreground hover:underline">{t(lang, "landing.guides.editorialLink")}</a
  >
</p>
