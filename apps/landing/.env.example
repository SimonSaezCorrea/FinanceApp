# Public site environment (all PUBLIC_*: inlined at build time, safe to expose).
# The API (scheme + host + port, no /api/v1).
PUBLIC_API_URL="http://localhost:3001"
# The signed-in app: where a sign-in lands and "Ir a la app" goes.
PUBLIC_APP_URL="http://localhost:5173"
# This site's own origin: canonical, hreflang, og:url and the sitemap.
PUBLIC_SITE_URL="http://localhost:4321"
