# Cloudflare Pages response headers (copied as-is into the build output).
/*
  # HTTPS only for a year, subdomains included (app. and api. are HTTPS-only behind Cloudflare):
  # without it the first visit by http:// could be intercepted before the redirect.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  # A baseline policy (security run-3): no plugins, no <base> rewriting the page's links, no framing,
  # forms post only to this site. Scripts and styles are not restricted yet (see docs/PENDING.md).
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The pages an email link opens carry a one-time token in the address (specs/032): never cached,
# and never sent on in a Referer (the page also says so in a <meta>).
/:lang/verify-email/
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/:lang/reset-password/
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
