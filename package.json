{
  "name": "finance-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @finance/api dev",
    "dev:web": "pnpm --filter @finance/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:migrate": "pnpm --filter @finance/api prisma:migrate",
    "db:seed": "pnpm --filter @finance/api prisma:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@swc/core", "@prisma/client", "prisma", "@nestjs/core"]
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
