{
  "name": "@finance/money",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./rate-format": {
      "types": "./dist/rateFormat.d.ts",
      "import": "./src/rateFormat.ts",
      "default": "./dist/rateFormat.js"
    },
    "./installment-simulation": {
      "types": "./dist/installmentSimulation.d.ts",
      "import": "./src/installmentSimulation.ts",
      "default": "./dist/installmentSimulation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.5.0"
  },
  "devDependencies": {
    "@finance/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
